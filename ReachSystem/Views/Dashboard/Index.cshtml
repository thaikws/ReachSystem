@{
    ViewData["Title"] = "Dashboard";
}

<h2>Dashboard</h2>

<div style="display:flex; gap:20px; flex-wrap:wrap; margin-top:20px;">

    <div class="card">
        <h3>Animais</h3>
        <p>@ViewBag.TotalAnimais</p>
    </div>

    <div class="card">
        <h3>Eventos</h3>
        <p>@ViewBag.TotalEventos</p>
    </div>

    <div class="card">
        <h3>Fichas</h3>
        <p>@ViewBag.TotalFichas</p>
    </div>

    <div class="card">
        <h3>Usuários</h3>
        <p>@ViewBag.TotalUsuarios</p>
    </div>

</div>

<style>
    .card {
        padding: 20px;
        border-radius: 10px;
        background: #f5f5f5;
        min-width: 150px;
        text-align: center;
    }
</style>