@using ReachSystem.Models
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h2 class="dashboard-title">
        Bem-vindo(a), @ViewBag.NomeUsuario!
    </h2>
    <p class="dashboard-subtitle">
        Visão geral do sistema
    </p>
</div>

<!-- Cards de estatísticas -->
<div class="row g-3">

    <div class="col-6 col-lg-3">
        <div class="stats-card">

            <div class="stats-title">
                <i class="fa-solid fa-paw"></i>
                Animais
            </div>

            <h2>@ViewBag.TotalAnimais</h2>

        </div>
    </div>


    <div class="col-6 col-lg-3">
        <div class="stats-card">

            <div class="stats-title">
                <i class="bi bi-calendar-event"></i>
                Eventos
            </div>

            <h2>@ViewBag.TotalEventos</h2>

        </div>
    </div>


    <div class="col-6 col-lg-3">
        <div class="stats-card">

            <div class="stats-title">
                <i class="bi bi-file-earmark-medical"></i>
                Fichas
            </div>

            <h2>@ViewBag.TotalFichas</h2>

        </div>
    </div>


    <div class="col-6 col-lg-3">
        <div class="stats-card">

            <div class="stats-title">
                <i class="bi bi-people-fill"></i>
                Usuários
            </div>

            <h2>@ViewBag.TotalUsuarios</h2>

        </div>
    </div>

</div>

<!-- Conteúdo inferior -->
<div class="row mt-4 g-4">

    <!-- Últimos Cadastros -->
    <div class="col-lg-6">
        <div class="dashboard-card">

            <div class="dashboard-header">
                <h4>Últimos Cadastros</h4>
            </div>

            <div class="dashboard-body">

                @foreach (var animal in (List<Animal>)ViewBag.UltimosAnimais)
                {
                    <div class="dashboard-item">

                        @if (!string.IsNullOrEmpty(animal.Foto))
                        {
                            <img src="@animal.Foto"
                                 alt="@animal.Nome"
                                 class="animal-avatar" />
                        }
                        else
                        {
                            <div class="animal-icon">
                                <i class="bi bi-heart-fill"></i>
                            </div>
                        }

                        <div class="animal-info">
                            <strong>@animal.Nome</strong>
                            <small>@animal.Especie • @animal.Raca</small>
                        </div>

                    </div>
                }

            </div>

        </div>
    </div>

    <!-- Próximos Eventos -->
    <div class="col-lg-6">
        <div class="dashboard-card">

            <div class="dashboard-header">
                <h4>Próximos Eventos</h4>
            </div>

            <div class="dashboard-body">

                @if (ViewBag.ProximosEventos != null && ((List<Evento>)ViewBag.ProximosEventos).Any())
                {
                    foreach (var evento in (List<Evento>)ViewBag.ProximosEventos)
                    {
                        <div class="dashboard-item">

                            <div class="animal-icon">
                                <i class="bi bi-calendar-event"></i>
                            </div>

                            <div class="animal-info">
                                <strong>@evento.Nome</strong>
                                <small>
                                    @evento.Data.ToString("dd/MM/yyyy")
                                </small>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">
                        Nenhum evento cadastrado.
                    </p>
                }

            </div>

        </div>
    </div>

</div>

<style>
    body {
        background: #F4F7FB;
        color: #173746;
    }


    /* ======================
       TÍTULO
    ====================== */

    .dashboard-title {
        font-weight: 700;
        color: #173746;
        font-size: clamp(1.4rem, 3vw, 2rem);
        margin-top: 40px;
    }

    .dashboard-subtitle {
        color: #6c7b88;
        margin-bottom: 0;
    }


    /* ======================
       CARDS ESTATÍSTICAS
    ====================== */

    .stats-card {
        background: white;
        border: 1px solid #E6EDF5;
        border-radius: 18px;
        padding: 20px 15px;
        text-align: center;
        height: 100%;
        transition: .2s;
    }


        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(44,93,124,.12);
        }


    .stats-title {
        color: #2C5D7C;
        font-size: 20px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .stats-title i {
            font-size: 1.1rem;
        }

    .stats-card h2 {
        margin: 8px 0 0;
        font-size: clamp(1.5rem, 4vw, 2rem);
        color: #173746;
        font-weight: 700;
    }


    /* ======================
       CARDS PRINCIPAIS
    ====================== */

    .dashboard-card {
        background: white;
        border: 1px solid #E6EDF5;
        border-radius: 18px;
        overflow: hidden;
        height: 100%;
    }


    .dashboard-header {
        background: #2C5D7C;
        padding: 16px 20px;
    }


        .dashboard-header h4 {
            color: white;
            margin: 0;
            font-weight: 600;
            font-size: 1.1rem;
        }


    .dashboard-body {
        padding: 18px 20px;
    }


    /* ======================
       LISTAS
    ====================== */

    .dashboard-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #E6EDF5;
    }


        .dashboard-item:last-child {
            border-bottom: none;
        }


    .animal-avatar,
    .animal-icon {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        flex-shrink: 0;
    }


    .animal-avatar {
        object-fit: cover;
        border: 2px solid #E6EDF5;
    }


    .animal-icon {
        background: #E6EDF5;
        color: #2C5D7C;
        display: flex;
        justify-content: center;
        align-items: center;
    }


    .animal-info {
        display: flex;
        flex-direction: column;
    }


        .animal-info strong {
            color: #173746;
            font-size: .95rem;
        }


        .animal-info small {
            color: #6c7b88;
            font-size: .8rem;
        }



    /* ======================
       MOBILE
    ====================== */

    @@media(max-width:576px) {
        .container

    {
        padding-left: 15px;
        padding-right: 15px;
    }


    .dashboard-title {
        font-size: 1.4rem;
    }


    .stats-card {
        padding: 16px 10px;
        border-radius: 15px;
    }


    .dashboard-header {
        padding: 14px 16px;
    }


    .dashboard-body {
        padding: 12px 16px;
    }


    .animal-avatar,
    .animal-icon {
        width: 48px;
        height: 48px;
    }


    .dashboard-item {
        gap: 10px;
    }

    }
</style>