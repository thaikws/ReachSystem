﻿<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/ReachSystem.styles.css" asp-append-version="true" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>

<header>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">

            <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                ReachSystem
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMain"
                    aria-controls="navbarMain"
                    aria-expanded="false"
                    aria-label="Alternar navegação">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navbarMain">

                <ul class="navbar-nav me-auto">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Animal" asp-action="Index">
                                Animais
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Evento" asp-action="Index">
                                Eventos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Consulta" asp-action="Index">
                                Consultas
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="FichaSaude" asp-action="Index">
                                Ficha de Saúde
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Usuario" asp-action="Index">
                                    Usuários
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                Login
                            </a>
                        </li>
                    }

                </ul>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="d-flex">

                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-link nav-link logout-btn">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Sair</span>
                        </button>

                    </form>
                }

            </div>

        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)