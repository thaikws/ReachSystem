@using Microsoft.AspNetCore.Identity
@using ReachSystem.Models
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ReachSystem</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ReachSystem.styles.css"
          asp-append-version="true" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap"
          rel="stylesheet">

</head>


@{
        ApplicationUser? usuarioLogado = null;

        if (User.Identity?.IsAuthenticated == true)
        {
                usuarioLogado = await UserManager.GetUserAsync(User);
        }

        var nomeUsuario = usuarioLogado?.Nome ?? "Usuário";

        var emailUsuario = usuarioLogado?.Email ?? "";

        var inicialUsuario =
                !string.IsNullOrWhiteSpace(nomeUsuario)
                        ? nomeUsuario.Trim()[0].ToString().ToUpper()
                        : "?";

        var funcaoUsuario =
                User.IsInRole("Admin")
                        ? "Administrador"
                        : User.IsInRole("Funcionario")
                                ? "Funcionário"
                                : "Voluntário";
}


<body>

    <!-- =====================================================
         LOGO MOBILE
    ====================================================== -->
    <!-- =====================================================
         LOGO MOBILE
    ====================================================== -->

    <div class="mobile-brand">

        <a asp-controller="@(User.Identity?.IsAuthenticated == true ? "Dashboard" : "Account")"
           asp-action="@(User.Identity?.IsAuthenticated == true ? "Index" : "Login")">

            ReachSystem

        </a>


        @if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Account"
               asp-action="Login"
               class="mobile-login-link">

                Login

            </a>
        }

    </div>


    <!-- =====================================================
         NAVBAR DESKTOP
    ====================================================== -->

    <header class="desktop-navbar-wrapper">

        <nav class="navbar navbar-expand-lg desktop-navbar">

            <div class="container-fluid">

                <!-- =================================================
                     LOGO
                ================================================== -->

                <a class="navbar-brand"
                   asp-controller="@(User.Identity?.IsAuthenticated == true ? "Dashboard" : "Account")"
                   asp-action="@(User.Identity?.IsAuthenticated == true ? "Index" : "Login")">

                    ReachSystem

                </a>


                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- =================================================
                         LINKS DO USUÁRIO LOGADO
                    ================================================== -->

                    <div class="navbar-collapse">

                        <ul class="navbar-nav me-auto">

                            <!-- DASHBOARD -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Index">

                                    Dashboard

                                </a>

                            </li>


                            <!-- ANIMAIS -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Animal"
                                   asp-action="Index">

                                    Animais

                                </a>

                            </li>


                            <!-- EVENTOS -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Evento"
                                   asp-action="Index">

                                    Eventos

                                </a>

                            </li>


                            <!-- CONSULTAS -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Consulta"
                                   asp-action="Index">

                                    Consultas

                                </a>

                            </li>


                            <!-- FICHA DE SAÚDE -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="FichaSaude"
                                   asp-action="Index">

                                    Ficha de Saúde

                                </a>

                            </li>


                            <!-- USUÁRIOS -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Usuario"
                                       asp-action="Index">

                                        Usuários

                                    </a>

                                </li>
                            }

                        </ul>


                        <!-- =================================================
                             PERFIL
                        ================================================== -->

                        <div class="profile-preview">

                            <button type="button"
                                    class="profile-avatar"
                                    aria-label="Abrir perfil">

                                @inicialUsuario

                            </button>


                            <!-- POPOVER -->

                            <div class="profile-popover">

                                <div class="profile-popover-header">

                                    <div class="profile-avatar profile-avatar-sm">

                                        @inicialUsuario

                                    </div>

                                    <div class="profile-user-info">

                                        <strong>
                                            @nomeUsuario
                                        </strong>

                                        <small>
                                            @emailUsuario
                                        </small>

                                    </div>

                                </div>


                                <!-- FUNÇÃO -->

                                <div class="profile-role">

                                    <i class="bi bi-person-badge"></i>

                                    <span>
                                        @funcaoUsuario
                                    </span>

                                </div>


                                <!-- MEU PERFIL -->

                                <a asp-controller="Perfil"
                                   asp-action="Index"
                                   class="profile-popover-link">

                                    <i class="bi bi-person"></i>

                                    <span>
                                        Meu perfil
                                    </span>

                                </a>


                                <!-- USUÁRIOS -->
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-controller="Usuario"
                                       asp-action="Index"
                                       class="profile-popover-link">

                                        <i class="bi bi-people"></i>

                                        <span>
                                            Usuários
                                        </span>

                                    </a>
                                }


                                <div class="profile-divider"></div>


                                <!-- SAIR -->

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="profile-logout">

                                        <i class="bi bi-box-arrow-right"></i>

                                        <span>
                                            Sair
                                        </span>

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <!-- =================================================
                         USUÁRIO DESLOGADO
                    ================================================== -->

                    <div class="navbar-collapse">

                        <ul class="navbar-nav ms-auto">

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>

                        </ul>

                    </div>
                }

            </div>

        </nav>

    </header>


    <!-- =====================================================
         CONTEÚDO
    ====================================================== -->

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- =====================================================
         NAVBAR MOBILE
    ====================================================== -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="mobile-bottom-navbar">

            <!-- DASHBOARD -->

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="mobile-nav-item">

                <i class="bi bi-house"></i>

                <span>
                    Dashboard
                </span>

            </a>


            <!-- ANIMAIS -->

            <a asp-controller="Animal"
               asp-action="Index"
               class="mobile-nav-item">

                <i class="bi bi-heart"></i>

                <span>
                    Animais
                </span>

            </a>


            <!-- EVENTOS -->

            <a asp-controller="Evento"
               asp-action="Index"
               class="mobile-nav-item">

                <i class="bi bi-calendar-event"></i>

                <span>
                    Eventos
                </span>

            </a>


            <!-- CONSULTAS -->

            <a asp-controller="Consulta"
               asp-action="Index"
               class="mobile-nav-item">

                <i class="bi bi-clipboard2-pulse"></i>

                <span>
                    Consultas
                </span>

            </a>


            <!-- FICHA -->

            <a asp-controller="FichaSaude"
               asp-action="Index"
               class="mobile-nav-item">

                <i class="bi bi-file-medical"></i>

                <span>
                    Ficha
                </span>

            </a>


            <!-- PERFIL -->

            <a asp-controller="Perfil"
               asp-action="Index"
               class="mobile-nav-item">

                <i class="bi bi-person"></i>

                <span>
                    Perfil
                </span>

            </a>

        </nav>
    }


    <!-- =====================================================
         SCRIPTS
    ====================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>