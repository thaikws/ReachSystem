@model IEnumerable<ReachSystem.Models.Participacao>

@{
    ViewData["Title"] = "Relatórios";

    var eventos = ViewBag.Eventos as List<string> ?? new List<string>();

    var pesquisar = ViewBag.Pesquisar as string;
    var eventoSelecionado = ViewBag.Evento as string;
    var statusSelecionado = ViewBag.Status as ReachSystem.Enums.StatusParticipacao?;
    var dataInicio = ViewBag.DataInicio as string;
    var dataFim = ViewBag.DataFim as string;

    var resultados = Model?.ToList() ?? new List<ReachSystem.Models.Participacao>();
}

<div class="report-page">

    <div class="container">

        <!-- =====================================================
             CABEÇALHO
        ====================================================== -->

        <div class="mb-4">

            <h2 class="report-title">
                Relatórios
            </h2>

            <p class="report-subtitle">
                Gere relatórios com os dados cadastrados no sistema.
            </p>

        </div>


        <!-- =====================================================
             TIPO DE RELATÓRIO
        ====================================================== -->

        <div class="report-type-card">

            <div class="report-type-label">
                <i class="bi bi-bar-chart-line-fill"></i>

                <span>
                    Tipo de relatório
                </span>
            </div>


            <div class="report-type-options">

                <a asp-controller="Relatorio"
                   asp-action="Index"
                   class="report-type-button">

                    <i class="bi bi-heart-fill"></i>

                    <span>Animais</span>

                </a>


                <a asp-controller="Relatorio"
                   asp-action="Eventos"
                   class="report-type-button">

                    <i class="bi bi-calendar-event-fill"></i>

                    <span>Eventos</span>

                </a>


                <a asp-controller="Relatorio"
                   asp-action="Participacoes"
                   class="report-type-button active">

                    <i class="bi bi-people-fill"></i>

                    <span>Participações</span>

                </a>

            </div>

        </div>


        <!-- =====================================================
             CONFIGURAÇÃO DO RELATÓRIO
        ====================================================== -->

        <div class="report-card">

            <div class="report-card-header">

                <div class="report-header-content">

                    <div class="report-header-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <div>

                        <strong>Relatório de Participações</strong>

                        <small>
                            Utilize os filtros para definir os dados que deseja visualizar.
                        </small>

                    </div>

                </div>

            </div>


            <div class="report-card-body">

                <form asp-controller="Relatorio"
                      asp-action="Participacoes"
                      method="get">

                    <!-- PESQUISA -->

                    <div class="mb-4">

                        <label for="pesquisar" class="report-label">
                            Pesquisar
                        </label>

                        <div class="report-input-wrapper">

                            <i class="bi bi-search"></i>

                            <input type="text"
                                   id="pesquisar"
                                   name="pesquisar"
                                   value="@pesquisar"
                                   class="form-control report-input"
                                   placeholder="Nome ou e-mail do participante..." />

                        </div>

                    </div>


                    <!-- FILTROS -->

                    <div class="row g-3">

                        <!-- EVENTO -->

                        <div class="col-md-4">

                            <label for="evento" class="report-label">
                                Evento
                            </label>

                            <select id="evento"
                                    name="evento"
                                    class="form-select report-select">

                                <option value="">
                                    Todos os eventos
                                </option>

                                @foreach (var item in eventos)
                                {
                                    if (eventoSelecionado == item)
                                    {
                                        <option value="@item" selected>
                                            @item
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@item">
                                            @item
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- STATUS -->

                        <div class="col-md-4">

                            <label for="status" class="report-label">
                                Status
                            </label>

                            <select id="status"
                                    name="status"
                                    class="form-select report-select">

                                <option value="">
                                    Todos os status
                                </option>

                                @foreach (var status in Enum.GetValues<ReachSystem.Enums.StatusParticipacao>())
                                {
                                    if (statusSelecionado == status)
                                    {
                                        <option value="@status" selected>
                                            @status
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@status">
                                            @status
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- DATA INICIAL -->

                        <div class="col-md-4">

                            <label for="dataInicio" class="report-label">
                                Data do evento inicial
                            </label>

                            <input type="date"
                                   id="dataInicio"
                                   name="dataInicio"
                                   value="@dataInicio"
                                   class="form-control report-input" />

                        </div>


                        <!-- DATA FINAL -->

                        <div class="col-md-4">

                            <label for="dataFim" class="report-label">
                                Data do evento final
                            </label>

                            <input type="date"
                                   id="dataFim"
                                   name="dataFim"
                                   value="@dataFim"
                                   class="form-control report-input" />

                        </div>

                    </div>


                    <!-- BOTÕES -->

                    <div class="report-form-actions">

                        <a asp-controller="Relatorio"
                           asp-action="Participacoes"
                           class="report-clear-button">

                            <i class="bi bi-arrow-counterclockwise"></i>

                            Limpar filtros

                        </a>


                        <button type="submit"
                                class="report-submit-button">

                            <i class="bi bi-bar-chart-line"></i>

                            Gerar relatório

                        </button>


                        <a asp-controller="Relatorio"
                           asp-action="ExportarExcelParticipacoes"
                           asp-route-pesquisar="@pesquisar"
                           asp-route-evento="@eventoSelecionado"
                           asp-route-status="@statusSelecionado"
                           asp-route-dataInicio="@dataInicio"
                           asp-route-dataFim="@dataFim"
                           class="report-excel-button">

                            <i class="bi bi-file-earmark-excel"></i>

                            Exportar Excel

                        </a>


                        <a asp-controller="Relatorio"
                           asp-action="ExportarPdfParticipacoes"
                           asp-route-pesquisar="@pesquisar"
                           asp-route-evento="@eventoSelecionado"
                           asp-route-status="@statusSelecionado"
                           asp-route-dataInicio="@dataInicio"
                           asp-route-dataFim="@dataFim"
                           class="report-pdf-button">

                            <i class="bi bi-file-earmark-pdf"></i>

                            Exportar PDF

                        </a>

                    </div>

                </form>

            </div>

        </div>


        <!-- =====================================================
             PRÉ-VISUALIZAÇÃO
        ====================================================== -->

        <div class="report-card report-preview-card">

            <div class="report-card-header">

                <div class="report-header-content">

                    <div class="report-header-icon">
                        <i class="bi bi-table"></i>
                    </div>

                    <div>

                        <strong>Pré-visualização</strong>

                        <small>
                            Dados encontrados de acordo com os filtros selecionados.
                        </small>

                    </div>

                </div>


                <span class="report-result-count">

                    @resultados.Count
                    @(resultados.Count == 1 ? "resultado" : "resultados")

                </span>

            </div>


            <div class="report-preview-body">

                @if (resultados.Any())
                {
                    <div class="table-responsive">

                        <table class="table align-middle report-table">

                            <thead>

                                <tr>

                                    <th>Participante</th>
                                    <th>E-mail</th>
                                    <th>Evento</th>
                                    <th>Data</th>
                                    <th>Local</th>
                                    <th>Status</th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var participacao in resultados)
                                {
                                    <tr>

                                        <td>
                                            <strong class="report-animal-name">
                                                @participacao.Usuario.Nome
                                            </strong>
                                        </td>

                                        <td>
                                            @participacao.Usuario.Email
                                        </td>

                                        <td>
                                            @participacao.Evento.Nome
                                        </td>

                                        <td>
                                            @participacao.Evento.Data.ToString("dd/MM/yyyy HH:mm")
                                        </td>

                                        <td>
                                            @participacao.Evento.Local
                                        </td>

                                        <td>

                                            <span class="report-status">
                                                @participacao.Status
                                            </span>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="report-empty">

                        <div class="report-empty-icon">
                            <i class="bi bi-file-earmark-x"></i>
                        </div>

                        <h5>
                            Nenhuma participação encontrada
                        </h5>

                        <p>
                            Não existem participações que correspondam aos filtros selecionados.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</div>


<style>

    body {
        background: #F4F7FB;
        color: #173746;
    }


    /* =========================================================
               PÁGINA
            ========================================================= */

    .report-page {
        min-height: calc(100vh - 100px);
        padding-bottom: 40px;
    }


    .report-title {
        font-weight: 700;
        color: #173746;
        font-size: clamp(1.4rem, 3vw, 2rem);
        margin-top: 40px;
        margin-bottom: 4px;
    }


    .report-subtitle {
        color: #6c7b88;
        margin-bottom: 0;
    }


    /* =========================================================
               TIPO DE RELATÓRIO
            ========================================================= */

    .report-type-card {
        background: #FFFFFF;
        border: 1px solid #E6EDF5;
        border-radius: 14px;
        padding: 14px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }


    .report-type-label {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #173746;
        font-size: .82rem;
        font-weight: 600;
        white-space: nowrap;
    }


        .report-type-label i {
            color: #2C5D7C;
            font-size: .95rem;
        }


    .report-type-options {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px;
        background: #F4F7FB;
        border-radius: 11px;
    }


    .report-type-button {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 7px 14px;
        border: 1px solid transparent;
        border-radius: 8px;
        background: transparent;
        color: #526673;
        text-decoration: none;
        font-family: "Sora", sans-serif;
        font-size: .75rem;
        font-weight: 500;
        transition: .2s ease;
        white-space: nowrap;
    }


        .report-type-button:hover {
            color: #173746;
            background: #FFFFFF;
            text-decoration: none;
        }


        .report-type-button.active {
            background: #2C5D7C;
            color: #FFFFFF;
            box-shadow: 0 2px 5px rgba(44, 93, 124, .16);
        }


            .report-type-button.active:hover {
                background: #173746;
                color: #FFFFFF;
            }


    /* =========================================================
               CARD
            ========================================================= */

    .report-card {
        background: #FFFFFF;
        border: 1px solid #E6EDF5;
        border-radius: 18px;
        overflow: hidden;
        margin-bottom: 20px;
    }


    .report-preview-card {
        margin-bottom: 0;
    }


    /* =========================================================
               CABEÇALHO
            ========================================================= */

    .report-card-header {
        background: #2C5D7C;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }


    .report-header-content {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }


    .report-header-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(255, 255, 255, .14);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #FFFFFF;
        font-size: 1.05rem;
        flex-shrink: 0;
    }


    .report-header-content strong {
        display: block;
        color: #FFFFFF;
        font-size: 1.05rem;
        font-weight: 600;
    }


    .report-header-content small {
        display: block;
        color: rgba(255, 255, 255, .78);
        font-size: .78rem;
        margin-top: 2px;
    }


    /* =========================================================
               CORPO
            ========================================================= */

    .report-card-body {
        padding: 22px;
    }


    /* =========================================================
               LABELS
            ========================================================= */

    .report-label {
        display: block;
        color: #173746;
        font-size: .82rem;
        font-weight: 600;
        margin-bottom: 7px;
    }


    /* =========================================================
               INPUTS
            ========================================================= */

    .report-input {
        min-height: 44px;
        border: 1px solid #DCE6EE;
        border-radius: 10px;
        color: #173746;
        font-size: .85rem;
        background-color: #FFFFFF;
        box-shadow: none !important;
    }


    .report-select {
        min-height: 44px;
        border: 1px solid #DCE6EE;
        border-radius: 10px;
        color: #173746;
        font-size: .85rem;
        background-color: #FFFFFF;
        box-shadow: none !important;
    }


    .report-input {
        padding: 10px 13px;
    }


    .report-select {
        padding: 10px 36px 10px 13px;
    }


    .report-input:focus {
        border-color: #2C5D7C;
        box-shadow: 0 0 0 3px rgba(44, 93, 124, .10) !important;
    }


    .report-select:focus {
        border-color: #2C5D7C;
        box-shadow: 0 0 0 3px rgba(44, 93, 124, .10) !important;
    }


    .report-input-wrapper {
        position: relative;
    }


        .report-input-wrapper > i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c7b88;
            font-size: .9rem;
            z-index: 2;
        }


        .report-input-wrapper .report-input {
            padding-left: 38px;
        }


    /* =========================================================
               BOTÕES
            ========================================================= */

    .report-form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid #E6EDF5;
    }


    .report-clear-button {
        min-height: 42px;
        padding: 9px 16px;
        border-radius: 10px;
        font-family: "Sora", sans-serif;
        font-size: .8rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: .2s ease;
    }
    .report-submit-button {
        min-height: 42px;
        padding: 9px 16px;
        border-radius: 10px;
        font-family: "Sora", sans-serif;
        font-size: .8rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: .2s ease;
    }


    .report-clear-button {
        border: 1px solid #DCE6EE;
        background: #FFFFFF;
        color: #526673;
    }


        .report-clear-button:hover {
            background: #F4F7FB;
            border-color: #C9D9E5;
            color: #173746;
        }


    .report-submit-button {
        border: 1px solid #2C5D7C;
        background: #2C5D7C;
        color: #FFFFFF;
        cursor: pointer;
    }


        .report-submit-button:hover {
            background: #173746;
            border-color: #173746;
            transform: translateY(-1px);
        }


    /* =========================================================
               CONTADOR
            ========================================================= */

    .report-result-count {
        background: rgba(255, 255, 255, .14);
        border: 1px solid rgba(255, 255, 255, .16);
        border-radius: 20px;
        padding: 5px 10px;
        color: #FFFFFF;
        font-size: .72rem;
        font-weight: 600;
        white-space: nowrap;
    }


    /* =========================================================
               PRÉ-VISUALIZAÇÃO
            ========================================================= */

    .report-preview-body {
        padding: 20px;
    }


    .report-table {
        margin-bottom: 0;
        min-width: 850px;
    }


        .report-table thead th {
            color: #2C5D7C;
            font-family: "Sora", sans-serif;
            font-size: .76rem;
            font-weight: 600;
            border-bottom: 1px solid #E6EDF5;
            padding: 12px 10px;
            white-space: nowrap;
        }


        .report-table tbody td {
            color: #173746;
            font-size: .82rem;
            padding: 13px 10px;
            border-bottom: 1px solid #E6EDF5;
            vertical-align: middle;
            white-space: nowrap;
        }


        .report-table tbody tr:last-child td {
            border-bottom: none;
        }


        .report-table tbody tr:hover {
            background: #F8FAFC;
        }


    .report-animal-name {
        color: #173746;
        font-weight: 600;
    }


    /* =========================================================
               STATUS
            ========================================================= */

    .report-status {
        display: inline-flex;
        align-items: center;
        padding: 4px 9px;
        border-radius: 20px;
        background: #EEF5F8;
        color: #2C5D7C;
        font-size: .72rem;
        font-weight: 600;
    }


    /* =========================================================
               ESTADO VAZIO
            ========================================================= */

    .report-empty {
        text-align: center;
        padding: 45px 20px;
    }


    .report-empty-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 14px;
        border-radius: 14px;
        background: #F4F7FB;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2C5D7C;
        font-size: 1.4rem;
    }


    .report-empty h5 {
        color: #173746;
        font-size: .95rem;
        font-weight: 600;
        margin-bottom: 6px;
    }


    .report-empty p {
        color: #6c7b88;
        font-size: .82rem;
        margin-bottom: 0;
    }


    /* =========================================================
               EXCEL
            ========================================================= */

    .report-excel-button {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 16px;
        border: 1px solid #2C5D7C;
        border-radius: 10px;
        background-color: #FFFFFF;
        color: #2C5D7C;
        text-decoration: none;
        font-family: "Sora", sans-serif;
        font-size: .8rem;
        font-weight: 500;
        cursor: pointer;
        transition: .2s ease;
    }


        .report-excel-button:hover {
            background-color: #2C5D7C;
            color: #FFFFFF;
            text-decoration: none;
            transform: translateY(-1px);
        }


    /* =========================================================
               PDF
            ========================================================= */

    .report-pdf-button {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 16px;
        border: 1px solid #D9534F;
        border-radius: 10px;
        background-color: #FFFFFF;
        color: #D9534F;
        text-decoration: none;
        font-family: "Sora", sans-serif;
        font-size: .8rem;
        font-weight: 500;
        cursor: pointer;
        transition: .2s ease;
    }


        .report-pdf-button:hover {
            background-color: #D9534F;
            color: #FFFFFF;
            text-decoration: none;
            transform: translateY(-1px);
        }


    /* =========================================================
               TABLET
            ========================================================= */

    @@media (max-width: 991.98px) {

        .report-title {
            margin-top: 25px;
        }

        .report-card-body {
            padding: 18px;
        }

        .report-preview-body {
            padding: 16px;
        }

        .report-type-card {
            align-items: stretch;
            flex-direction: column;
        }

        .report-type-label {
            justify-content: center;
        }

        .report-type-options {
            width: 100%;
        }

        .report-type-button {
            flex: 1;
        }
    }


    /* =========================================================
               TELAS PEQUENAS
            ========================================================= */

    @@media (max-width: 576px) {

        .report-page {
            padding-bottom: 85px;
        }


        .report-title {
            font-size: 1.4rem;
            margin-top: 20px;
        }


        .report-subtitle {
            font-size: .85rem;
        }


        .report-type-card {
            padding: 10px;
            border-radius: 13px;
        }


        .report-type-label {
            justify-content: flex-start;
            padding: 3px 4px;
        }


        .report-type-options {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 4px;
            padding: 4px;
        }


        .report-type-button {
            min-height: 38px;
            padding: 7px 5px;
            gap: 4px;
            font-size: .68rem;
        }


            .report-type-button i {
                font-size: .75rem;
            }


        .report-card {
            border-radius: 15px;
            margin-bottom: 16px;
        }


        .report-card-header {
            padding: 14px 16px;
            align-items: flex-start;
        }


        .report-header-content {
            gap: 9px;
        }


        .report-header-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            font-size: .9rem;
        }


        .report-header-content strong {
            font-size: .92rem;
        }


        .report-header-content small {
            font-size: .7rem;
            line-height: 1.35;
        }


        .report-result-count {
            font-size: .68rem;
            padding: 4px 8px;
        }


        .report-card-body {
            padding: 16px;
        }


        .report-preview-body {
            padding: 12px;
        }


        .report-form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }


        .report-clear-button,
        .report-submit-button,
        .report-excel-button,
        .report-pdf-button {
            width: 100%;
        }


        .report-table {
            min-width: 850px;
        }


        .report-empty {
            padding: 35px 15px;
        }
    }

</style>

<span class="report-type-button disabled"
      title="Relatório de participações em desenvolvimento">

    <i class="bi bi-people-fill"></i>

    <span>Participações</span>

</span>

<a asp-controller="Relatorio"
   asp-action="Participacoes"
   class="report-type-button">

    <i class="bi bi-people-fill"></i>

    <span>Participações</span>

</a>
<a asp-controller="Relatorio"
   asp-action="Participacoes"
   class="report-type-button">

    <i class="bi bi-people-fill"></i>

    <span>Participações</span>

</a>

