@{
    ViewData["Title"] = "Login";
}

<div class="container-fluid">

    <div class="row justify-content-center align-items-center"
         style="min-height: 100vh;">

        <div class="col-12 col-sm-10 col-md-6 col-lg-5">

            <div class="card shadow login-card">

                <div class="card-header text-center login-header">
                    <strong>Login</strong>
                </div>

                <div class="card-body">

                    <form asp-action="Login" method="post" class="row g-3">

                        @Html.AntiForgeryToken()

                        <div class="col-12">
                            <label class="form-label">E-mail</label>
                            <input type="text"
                                   name="email"
                                   class="form-control"
                                   placeholder="Digite seu e-mail" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Senha</label>
                            <input type="password"
                                   name="senha"
                                   class="form-control"
                                   placeholder="Digite sua senha" />
                        </div>

                        <div class="col-12 form-check mt-2">
                            <input type="checkbox"
                                   name="rememberMe"
                                   class="form-check-input" />
                            <label class="form-check-label">
                                Lembrar de mim
                            </label>
                        </div>

                        <div class="col-12 d-flex flex-column flex-md-row justify-content-end mt-3">

                            <button type="submit" class="btn btn-main">
                                Entrar
                            </button>

                            <a asp-action="Register"
                               class="btn btn-secondary mt-2 mt-md-0 ms-md-2">
                                Criar conta
                            </a>

                        </div>

                    </form>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="mt-3">
                            <span class="text-danger">
                                E-mail ou senha inválidos.
                            </span>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>

<style>
    body {
        background: #f4f7fb;
    }

    .login-card {
        border-radius: 16px;
        overflow: hidden;
    }

    .login-header {
        background: #2c5d7c;
        color: white;
        font-size: 20px;
        padding: 15px;
    }

    .form-label {
        color: #2c5d7c;
        font-weight: 600;
    }

    .form-control {
        border-radius: 10px;
        padding: 10px;
    }

    .form-control:focus {
        border-color: #2c5d7c;
        box-shadow: 0 0 0 0.2rem rgba(44,93,124,0.2);
    }

    .btn-main {
        background: #2c5d7c;
        color: white;
        border-radius: 10px;
        padding: 10px 20px;
    }

    .btn-main:hover {
        background: #244b63;
        color: white;
    }

    .btn-secondary {
        border-radius: 10px;
    }
</style>