@{
    ViewData["Title"] = "Login";
}


<div class="login-container">

    <div class="login-card card shadow">

        <div class="card-header text-center login-header">
            <strong>Login</strong>
        </div>


        <div class="card-body">

            <form asp-action="Login" method="post" class="row g-3">

                @Html.AntiForgeryToken()


                <div class="col-12">
                    <label class="form-label">E-mail</label>

                    <input type="text"
                           name="email"
                           class="form-control"
                           placeholder="Digite seu e-mail" />
                </div>


                <div class="col-12">
                    <label class="form-label">Senha</label>

                    <input type="password"
                           name="senha"
                           class="form-control"
                           placeholder="Digite sua senha" />
                </div>


                <div class="col-12 form-check mt-2">

                    <input type="checkbox"
                           name="rememberMe"
                           class="form-check-input" />

                    <label class="form-check-label">
                        Lembrar de mim
                    </label>

                </div>


                <div class="col-12 mt-3">

                    <button type="submit" class="btn btn-main">
                        Entrar
                    </button>

                </div>


            </form>


            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mt-3 text-center">
                    <span class="text-danger">
                        E-mail ou senha inválidos.
                    </span>
                </div>
            }


        </div>

    </div>

</div>

<style>

    body {
        background: #f4f7fb;
    }


    /* Área somente do login */
    .login-container {
        min-height: calc(100vh - 80px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px 15px;
    }



    /* Card */
    .login-card {
        width: 100%;
        max-width: 420px;
        border: none;
        border-radius: 20px;
        overflow: hidden;
        background: white;
        box-shadow: 0 12px 35px rgba(0,0,0,.08);
    }



    /* Cabeçalho */
    .login-header {
        background: linear-gradient(135deg, #2c5d7c, #39789f);
        color: white;
        font-size: 22px;
        font-weight: 600;
        padding: 25px;
    }



    /* Corpo */
    .card-body {
        padding: 35px;
    }



    /* Labels */
    .form-label {
        color: #2c5d7c;
        font-weight: 600;
        margin-bottom: 8px;
    }



    /* Inputs */
    .form-control {
        border-radius: 12px;
        padding: 12px 15px;
        border: 1px solid #d9e3ec;
        transition: .3s;
    }



        .form-control:focus {
            border-color: #2c5d7c;
            box-shadow: 0 0 0 .25rem rgba(44,93,124,.15);
        }



    /* Botão */
    .btn-main {
        width: 100%;
        background: #2c5d7c;
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: 600;
        transition: .3s;
    }



        .btn-main:hover {
            background: #244b63;
            color: white;
            transform: translateY(-2px);
        }



    /* Erro */
    .text-danger {
        font-size: 14px;
    }



    /* Mobile */
    @@media(max-width:576px) {


        .login-container {
            min-height: calc(100vh - 70px);
            padding: 20px 15px;
        }


        .login-card {
            border-radius: 16px;
        }


        .login-header {
            font-size: 20px;
            padding: 20px;
        }


        .card-body {
            padding: 25px 20px;
        }
    }

</style>