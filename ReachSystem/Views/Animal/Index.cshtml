@model IEnumerable<ReachSystem.Models.Animal>

<h2>Lista de Animais</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo Animal</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Espécie</th>
            <th>Idade</th>
            <th>Raça</th>
            <th>Porte</th>
            <th>Sexo</th>
            <th>Status</th>
            <th>Data de Entrada</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AnimalId</td>
                <td>@item.Nome</td>
                <td>@item.Especie</td>
                <td>@item.Idade</td>
                <td>@item.Raca</td>
                <td>@item.Porte</td>
                <td>@item.SexoAnimal</td>
                <td>@item.StatusAnimal</td>

                <td>
                    <a asp-action="Update" asp-route-id="@item.AnimalId" class="btn btn-warning btn-sm">Editar</a>

                    <a asp-action="Delete" asp-route-id="@item.AnimalId" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>