@model IEnumerable<ReachSystem.Models.Animal>

@{
    ViewData["Title"] = "Animais";
}

<!-- TOPO -->
<div class="topo">
    <h1 class="titulo">Animais Abrigados</h1>

    <input type="text" id="searchInput" class="search-box" placeholder="Pesquisar animais..." />
</div>

<!-- LINHA -->
<div class="linha"></div>

<!-- AÇÕES -->
<div class="acoes">
    <a asp-action="Create" class="btn-add">+ Adicionar</a>
</div>

<!-- CARDS -->
<div class="lista" id="listaAnimais">
    @foreach (var item in Model)
    {
        <div class="card-animal item" data-nome="@item.Nome.ToLower()">
            <h3>@item.Nome</h3>
            <p>Idade: @item.Idade anos</p>
        </div>
    }
</div>

<!-- EMPTY STATE -->
<div id="emptyState" class="empty-state" style="display:none;">
    <div class="icon">🔍</div>
    <h2>Nenhum animal encontrado</h2>
    <p>Tente pesquisar por outro nome.</p>
</div>

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f8f9fb;
    }

    /* TOPO */
    .topo {
        display: flex;
        align-items: center;
        gap: 30px;
        padding: 30px 60px 20px 60px;
    }

    .titulo {
        font-size: 32px;
        color: #2c5d7c;
        margin: 0;
        white-space: nowrap;
    }

    .search-box {
        flex: 1;
        max-width: 700px;
        padding: 14px 25px;
        border-radius: 30px;
        border: 2px solid #2c5d7c;
        font-size: 16px;
        outline: none;
    }

    /* LINHA */
    .linha {
        width: 100%;
        height: 2px;
        background: #dcdcdc;
    }

    /* BOTÃO */
    .acoes {
        display: flex;
        justify-content: flex-end;
        padding: 20px 60px;
    }

    .btn-add {
        background: #2c5d7c;
        color: white;
        padding: 12px 22px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 16px;
        transition: 0.2s;
    }

        .btn-add:hover {
            opacity: 0.9;
        }

    /* GRID DE CARDS */
    .lista {
        padding: 0 60px;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
    }

    /* CARD */
    .card-animal {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        transition: 0.2s;
    }

        .card-animal:hover {
            transform: translateY(-5px);
        }

        .card-animal h3 {
            margin: 0;
            color: #2c5d7c;
        }

        .card-animal p {
            margin-top: 10px;
            color: #555;
        }

    /* IMPORTANTE: NÃO QUEBRAR CARD */
    .item {
        display: block;
    }

    /* EMPTY STATE */
    .empty-state {
        position: absolute;
        top: 55%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: #666;
    }

        .empty-state .icon {
            font-size: 50px;
            margin-bottom: 10px;
            opacity: 0.5;
        }

        .empty-state h2 {
            margin: 10px 0 5px;
            font-weight: 600;
        }

        .empty-state p {
            margin: 0;
            font-size: 14px;
        }
</style>

<script>
    const input = document.getElementById("searchInput");
    const items = document.querySelectorAll(".item");
    const emptyState = document.getElementById("emptyState");

    input.addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
            e.preventDefault();

            const filtro = input.value.toLowerCase();
            let encontrou = false;

            if (filtro === "") {
                items.forEach(item => item.style.display = "block");
                emptyState.style.display = "none";
                return;
            }

            items.forEach(item => {
                const nome = item.getAttribute("data-nome");

                if (nome.includes(filtro)) {
                    item.style.display = "block";
                    encontrou = true;
                } else {
                    item.style.display = "none";
                }
            });

            emptyState.style.display = encontrou ? "none" : "block";
        }
    });
</script>