@model IEnumerable<ReachSystem.Models.Animal>

@{
    ViewData["Title"] = "Animais";
}

<div class="topo">
    <h1 class="titulo">Animais Abrigados</h1>

    <input type="text"
           id="searchInput"
           class="search-box"
           placeholder="Pesquisar animais..." />

</div>

<div class="linha"></div>

<div class="acoes">
    <a asp-action="Create" class="btn-add">
        + Adicionar
    </a>
</div>

<div class="lista" id="listaAnimais">
    @foreach (var item in Model)
    {
        <div class="card-animal item"
             data-nome="@item.Nome.ToLower()">

            @if (!string.IsNullOrEmpty(item.Foto))
            {
                <img src="@item.Foto"
                     class="foto-animal" />
            }
            else
            {
                <img src="/images/sem-foto.png"
                     class="foto-animal" />
            }

            <h3>@item.Nome</h3>

            <p><strong>ID:</strong> @item.AnimalId</p>
            <p><strong>Espécie:</strong> @item.Especie</p>
            <p><strong>Idade:</strong> @item.Idade anos</p>

            <a asp-action="Details"
               asp-route-id="@item.AnimalId"
               class="btn-detalhes">
                Ver detalhes
            </a>
        </div>
    }

</div>

<div id="emptyState"
     class="empty-state"
     style="display:none;">
    <div class="icon">🔍</div>
    <h2>Nenhum animal encontrado</h2>
    <p>Tente pesquisar por outro nome.</p>
</div>

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f8f9fb;
    }

    .topo {
        display: flex;
        align-items: center;
        gap: 30px;
        padding: 30px 60px 20px 60px;
    }

    .titulo {
        font-size: 32px;
        color: #2c5d7c;
        margin: 0;
        white-space: nowrap;
    }

    .search-box {
        flex: 1;
        max-width: 700px;
        padding: 14px 25px;
        border-radius: 30px;
        border: 2px solid #2c5d7c;
        font-size: 16px;
        outline: none;
    }

    .linha {
        width: 100%;
        height: 2px;
        background: #dcdcdc;
    }

    .acoes {
        display: flex;
        justify-content: flex-end;
        padding: 20px 60px;
    }

    .btn-add {
        background: #2c5d7c;
        color: white;
        padding: 12px 22px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 16px;
        transition: 0.2s;
    }

        .btn-add:hover {
            opacity: 0.9;
        }

    .lista {
        padding: 0 60px;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 20px;
    }

    .card-animal {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        transition: 0.2s;
    }

        .card-animal:hover {
            transform: translateY(-5px);
        }

    .foto-animal {
        width: 100%;
        height: 190px;
        object-fit: cover;
    }

    .card-animal h3 {
        margin: 15px;
        color: #2c5d7c;
    }

    .card-animal p {
        margin: 8px 15px;
        color: #555;
    }

    .btn-detalhes {
        display: inline-block;
        margin: 15px;
        background: #2c5d7c;
        color: white;
        padding: 8px 14px;
        border-radius: 8px;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-detalhes:hover {
            opacity: 0.9;
        }

    .item {
        display: block;
    }

    .empty-state {
        position: absolute;
        top: 55%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: #666;
    }

        .empty-state .icon {
            font-size: 50px;
            margin-bottom: 10px;
            opacity: 0.5;
        }
</style>

<script>
    const input = document.getElementById("searchInput");
    const items = document.querySelectorAll(".item");
    const emptyState = document.getElementById("emptyState");

    input.addEventListener("input", function () {

        const filtro = input.value.toLowerCase().trim();
        let encontrou = false;

        items.forEach(item => {

            const nome = item.getAttribute("data-nome") || "";

            if (nome.includes(filtro)) {
                item.style.display = "";
                encontrou = true;
            } else {
                item.style.display = "none";
            }
        });

        emptyState.style.display = encontrou ? "none" : "block";
    });
</script>
