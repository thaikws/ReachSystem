@model ReachSystem.Models.Animal

<h2>Detalhes do Animal</h2>

<hr />

<p><strong>ID:</strong> @Model.AnimalId</p>
<p><strong>Nome:</strong> @Model.Nome</p>
<p><strong>Espécie:</strong> @Model.Especie</p>
<p><strong>Idade:</strong> @Model.Idade</p>
<p><strong>Raça:</strong> @Model.Raca</p>
<p><strong>Porte:</strong> @Model.Porte</p>
<p><strong>Sexo:</strong> @Model.SexoAnimal</p>
<p><strong>Status:</strong> @Model.StatusAnimal</p>
<p><strong>Data de Entrada:</strong> @Model.DataDeEntrada.ToShortDateString()</p>

<hr />

<h3>Ficha de Saúde</h3>

@if (Model.FichaSaude != null)
{
    <p><strong>Descrição:</strong> @Model.FichaSaude.Descricao</p>

    <a asp-controller="FichaSaude"
       asp-action="Details"
       asp-route-id="@Model.FichaSaude.FichaSaudeId"
       class="btn btn-info">
        Ver Ficha Completa
    </a>
}
else
{
    <p>Este animal não possui ficha de saúde.</p>

    <a asp-controller="FichaSaude"
       asp-action="Create"
       asp-route-animalId="@Model.AnimalId"
       class="btn btn-success">
        Criar Ficha
    </a>
}

<br />
<br />

<a asp-action="Index" class="btn btn-secondary">Voltar</a>