@model ReachSystem.Models.Animal

<div class="container">

    @if (!string.IsNullOrEmpty(Model.Foto))
    {
        <img src="@Model.Foto" class="foto-animal" />
    }
    else
    {
        <img src="/images/sem-foto.png" class="foto-animal" />
    }

    <h2>@Model.Nome</h2>

    <hr />

    <p><strong>ID:</strong> @Model.AnimalId</p>
    <p><strong>Espécie:</strong> @Model.Especie</p>
    <p><strong>Raça:</strong> @Model.Raca</p>
    <p><strong>Idade:</strong> @Model.Idade anos</p>
    <p><strong>Porte:</strong> @Model.Porte</p>
    <p><strong>Sexo:</strong> @Model.SexoAnimal</p>
    <p><strong>Status:</strong> @Model.StatusAnimal</p>
    <p><strong>Data de Entrada:</strong> @Model.DataDeEntrada.ToString("dd/MM/yyyy")</p>

    <hr />

    <h3>Ficha de Saúde</h3>

    @if (Model.FichaSaude != null)
    {
        <p>
            <strong>Descrição:</strong>
            @Model.FichaSaude.Descricao
        </p>

        <a asp-controller="FichaSaude"
           asp-action="Details"
           asp-route-id="@Model.FichaSaude.FichaSaudeId"
           class="btn btn-info">
            Ver Ficha Completa
        </a>
    }
    else
    {
        <p>Este animal não possui ficha de saúde cadastrada.</p>

        <a asp-controller="FichaSaude"
           asp-action="Create"
           asp-route-animalId="@Model.AnimalId"
           class="btn btn-success">
            Criar Ficha
        </a>
    }

    <hr />

    <a asp-action="Update"
       asp-route-id="@Model.AnimalId"
       class="btn btn-warning">
        Editar Animal
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Voltar para Lista
    </a>

</div>

<style>
    .container {
        max-width: 700px;
        margin: 40px auto;
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        font-family: Arial;
    }

    .foto-animal {
        width: 100%;
        height: 320px;
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 15px;
    }

    h2 {
        text-align: center;
        margin-bottom: 10px;
    }

    p {
        font-size: 16px;
        margin: 6px 0;
    }

    hr {
        margin: 20px 0;
    }

    a.btn {
        display: inline-block;
        margin: 5px 5px 0 0;
        padding: 8px 12px;
        border-radius: 8px;
        text-decoration: none;
        color: white;
    }

    .btn-info {
        background: #17a2b8;
    }

    .btn-success {
        background: #28a745;
    }

    .btn-warning {
        background: #ffc107;
        color: black;
    }

    .btn-secondary {
        background: #6c757d;
    }
</style>
