@using ReachSystem.Enums
@model ReachSystem.Models.Animal

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />

<div class="container py-4">

    <h2 class="page-title mb-4">
        Cadastrar Animal
    </h2>

    <div class="card card-custom shadow-sm">

        <div class="card-header-custom">
            <h4>Novo Animal</h4>
        </div>

        <div class="card-body p-4">

            <form asp-action="Create" id="formAnimal" enctype="multipart/form-data">

                <input type="hidden" id="imagemCortada" name="imagemCortada" />

                <div class="row g-4">

                    <!-- FOTO -->
                    <div class="col-lg-4">

                        <label class="form-label">Foto do Animal</label>

                        <div class="text-center">

                            <img id="preview"
                                 class="animal-preview mb-3"
                                 style="visibility:hidden;" />

                            <input type="file"
                                   class="form-control"
                                   id="inputImagem"
                                   name="fotoArquivo"
                                   accept="image/*" />

                        </div>

                    </div>

                    <!-- CAMPOS -->
                    <div class="col-lg-8">

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="Nome" class="form-label"></label>
                                <input asp-for="Nome" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Especie" class="form-label"></label>
                                <input asp-for="Especie" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Raca" class="form-label"></label>
                                <input asp-for="Raca" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Idade" class="form-label"></label>
                                <input asp-for="Idade" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Porte" class="form-label"></label>
                                <input asp-for="Porte" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SexoAnimal" class="form-label"></label>
                                <select asp-for="SexoAnimal"
                                        asp-items="Html.GetEnumSelectList<Sexo>()"
                                        class="form-select">
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="StatusAnimal" class="form-label"></label>
                                <select asp-for="StatusAnimal"
                                        asp-items="Html.GetEnumSelectList<Status>()"
                                        class="form-select">
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DataDeEntrada" class="form-label"></label>
                                <input asp-for="DataDeEntrada"
                                       class="form-control"
                                       type="date" />
                            </div>

                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-custom">
                        Voltar
                    </a>

                    <button type="submit"
                            class="btn btn-primary-custom px-4">
                        Salvar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
<style>
    body {
        background: #F4F7FB;
        font-family: 'Public Sans', sans-serif;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Sora', sans-serif;
    }

    .page-title {
        color: #173746;
        font-weight: 700;
    }

    .card-custom {
        background: #FFFFFF;
        border: none;
        border-radius: 18px;
        overflow: hidden;
    }

    .card-header-custom {
        background: #2C5D7C;
        color: #FFFFFF;
        padding: 18px 24px;
    }

        .card-header-custom h4 {
            margin: 0;
            font-weight: 600;
        }

    .animal-card {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 18px;
        margin-bottom: 25px;
        border-radius: 16px;
        background: #FFFFFF;
        border: 1px solid #E6EDF5;
        box-shadow: 0 3px 10px rgba(0,0,0,.05);
    }

    .animal-img {
        width: 120px;
        height: 180px;
        object-fit: cover;
        border-radius: 14px;
        background: #E6EDF5;
        border: 2px solid #E6EDF5;
    }

    .animal-info h5 {
        margin-bottom: 5px;
        color: #173746;
        font-weight: 600;
    }

    .animal-info small {
        color: #6C7A89;
    }

    .form-label {
        color: #173746;
        font-weight: 600;
    }

    .form-control,
    .form-select {
        border: 1px solid #E6EDF5;
        background: #FFFFFF;
        border-radius: 10px;
        padding: 10px 14px;
    }

    .form-control\:focus,
    .form-select\:focus {
        border-color: #1B6EC2;
        box-shadow: 0 0 0 .2rem rgba(27,110,194,.15);
    }

    .btn-primary-custom {
        background: #2C5D7C;
        color: #FFFFFF;
        border: none;
    }

    .btn-primary-custom\:hover {
        background: #234B64;
        color: #FFFFFF;
    }

    .btn-outline-custom {
        border: 1px solid #1B6EC2;
        color: #1B6EC2;
        background: transparent;
    }

    .btn-outline-custom\:hover {
        background: #1B6EC2;
        color: #FFFFFF;
    }
</style>

<div class="box">
    <h1>Cadastrar Animal</h1>

    <form asp-action="Create">
        <input asp-for="Nome" placeholder="Nome" />
        <input asp-for="Especie" placeholder="Espécie" />
        <input asp-for="Raca" placeholder="Raça" />
        <input asp-for="Idade" type="number" placeholder="Idade" />
        <input asp-for="Porte" placeholder="Porte" />

    .text-muted-custom {
        color: #6C7A89;
    }

    .animal-preview {
        width: 260px;
        height: 260px;
        object-fit: cover;
        border-radius: 16px;
        border: 2px dashed #E6EDF5;
        background: #F4F7FB;
        display: block;
        margin: auto;
    }

    .cropper-container {
        max-width: 100%;
    }

    .card-body {
        overflow: hidden;
    }

    .btn-primary-custom,
    .btn-outline-custom {
        border-radius: 10px;
        padding: .6rem 1.5rem;
        font-weight: 600;
    }

    .form-control,
    .form-select {
        height: 48px;
    }

    @@media (max-width:768px) {
        .animal-preview

    {
        max-width: 220px;
        margin-bottom: 20px;
    }

    .card-body {
        padding: 1.5rem;
    }

    }
</style>


<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

<script>
        let cropper;

    const input = document.getElementById("inputImagem");
    const preview = document.getElementById("preview");
    const form = document.getElementById("formAnimal");


    input.addEventListener("change", function(e){

        const file = e.target.files[0];

        if(!file) return;


        const reader = new FileReader();


        reader.onload = function(event){


            preview.src = event.target.result;

            preview.style.visibility = "visible";


            if(cropper){

                cropper.destroy();

            }


            cropper = new Cropper(preview, {

                aspectRatio: 1,

                viewMode: 1,

                autoCropArea: 1,

                responsive:true,

                background:false,

                movable:true,

                zoomable:true,

                cropBoxResizable:true

            });


        };


        reader.readAsDataURL(file);


    });



    form.addEventListener("submit", function(){


        if(cropper){


            const canvas = cropper.getCroppedCanvas({

                width:500,

                height:500

            });


            document.getElementById("imagemCortada").value =
                canvas.toDataURL("image/jpeg");


        }


    });
</script>
