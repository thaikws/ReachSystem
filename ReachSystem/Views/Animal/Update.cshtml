@using ReachSystem.Enums
@model ReachSystem.Models.Animal

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
<div class="box">
    <h1>Editar Animal</h1>

    <form asp-action="Update" id="formAnimal" enctype="multipart/form-data">

        <input type="hidden" asp-for="AnimalId" />
        <input type="hidden" asp-for="Foto" />

        @if (!string.IsNullOrEmpty(Model.Foto))
        {
            <img src="@Model.Foto" class="foto-preview" />
        }

        <label>Nova Foto</label>
        <input type="hidden" id="imagemCortada" name="imagemCortada" />
        <input type="file" name="fotoArquivo" id="inputImagem" accept="image/*" />
        <div class="crop-container">
            <img id="preview" style="max-width:100%; margin-top:10px; visibility:hidden;" />
        </div>

        <label asp-for="Nome"></label>
        <input asp-for="Nome" />

        <label asp-for="Especie"></label>
        <input asp-for="Especie" />

        <label asp-for="Raca"></label>
        <input asp-for="Raca" />

        <label asp-for="Idade"></label>
        <input asp-for="Idade" />

        <label asp-for="Porte"></label>
        <input asp-for="Porte" />

        <label asp-for="SexoAnimal"></label>
        <select asp-for="SexoAnimal"
                asp-items="Html.GetEnumSelectList<Sexo>()">
        </select>

        <label asp-for="StatusAnimal"></label>
        <select asp-for="StatusAnimal"
                asp-items="Html.GetEnumSelectList<Status>()">
        </select>

        <label asp-for="DataDeEntrada"></label>
        <input asp-for="DataDeEntrada" type="date" />

        <button type="submit">
            Salvar Alterações
        </button>

    </form>

    <a asp-action="Index">Voltar</a>

</div>

<style>
    body {
        font-family: Arial;
        background-color: #f4f6f9;
    }

    .box {
        background: white;
        padding: 25px;
        margin: 40px auto;
        width: 380px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    h1 {
        text-align: center;
    }

    label {
        font-weight: bold;
        display: block;
        margin-top: 10px;
    }

    input, select {
        width: 100%;
        padding: 8px;
        margin-top: 5px;
        border-radius: 6px;
        border: 1px solid #ccc;
        box-sizing: border-box;
    }

    .foto-preview {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 15px;
    }

    button {
        width: 100%;
        margin-top: 15px;
        padding: 10px;
        border: none;
        border-radius: 6px;
        background: green;
        color: white;
        font-weight: bold;
        cursor: pointer;
    }

        button:hover {
            background: darkgreen;
        }

    a {
        display: block;
        text-align: center;
        margin-top: 10px;
    }

    .crop-container {
        width: 300px;
        height: 300px;
        margin: 10px auto;
        overflow: hidden;
    }

    #preview {
        max-width: 100%;
        display: block;
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

<script>
    let cropper;

    const input = document.getElementById("inputImagem");
    const preview = document.getElementById("preview");
    const form = document.getElementById("formAnimal");

    input.addEventListener("change", function (e) {

        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();

        reader.onload = function (event) {

            preview.src = event.target.result;
            preview.style.display = "block";

            if (cropper) {
                cropper.destroy();
            }

            cropper = new Cropper(preview, {
                aspectRatio: 1,
                viewMode: 1,
                autoCropArea: 1,
                movable: true,
                zoomable: true,
                cropBoxResizable: true
            });
        };

        reader.readAsDataURL(file);
    });

    form.addEventListener("submit", function () {

        if (cropper) {

            const canvas = cropper.getCroppedCanvas({
                width: 500,
                height: 500
            });

            document.getElementById("imagemCortada").value =
                canvas.toDataURL("image/jpeg");
        }
    });
</script>
