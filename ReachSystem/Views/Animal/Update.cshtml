@model ReachSystem.Models.Animal

<div class="box">
    <h1>Editar Animal</h1>

    <form asp-action="Update">
        <input type="hidden" asp-for="AnimalId" />

        <input asp-for="Nome" />
        <input asp-for="Especie" />
        <input asp-for="Raca" />
        <input asp-for="Idade" type="number" />
        <input asp-for="Porte" />

        <select asp-for="SexoAnimal" asp-items="Html.GetEnumSelectList<ReachSystem.Enums.Sexo>()"></select>
        <select asp-for="StatusAnimal" asp-items="Html.GetEnumSelectList<ReachSystem.Enums.Status>()"></select>

        <input asp-for="DataDeEntrada" type="date" />

        <button type="submit">Salvar</button>
    </form>
</div>