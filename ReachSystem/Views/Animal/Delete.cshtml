@model ReachSystem.Models.Animal

<div class="box">
    <h1>Deletar</h1>

    <p>Tem certeza que deseja deletar?</p>
    <p><strong>@Model.Nome</strong></p>

    <form asp-action="Delete">
        <input type="hidden" asp-for="AnimalId" />
        <button type="submit">Deletar</button>
    </form>

    <a asp-action="Index">Cancelar</a>
</div>

<style>
    body {
        font-family: Arial;
        background-color: #f4f6f9;
    }

    .box {
        background: white;
        padding: 25px;
        margin: 40px auto;
        width: 300px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        text-align: center;
    }

    h1 {
        margin-bottom: 10px;
    }

    p {
        font-size: 18px;
    }

    button {
        width: 100%;
        margin-top: 15px;
        padding: 10px;
        border: none;
        border-radius: 6px;
        background: red;
        color: white;
        font-weight: bold;
        cursor: pointer;
    }

        button:hover {
            background: darkred;
        }

    a {
        display: block;
        margin-top: 10px;
    }
</style>
