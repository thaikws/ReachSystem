@model ReachSystem.Models.Animal

<div class="box">
    <h1>Excluir Animal</h1>

    <p style="text-align:center; color:red; font-weight:bold;">
        Tem certeza que deseja excluir este animal?
    </p>

    <hr />

    <p><strong>Nome:</strong> @Model.Nome</p>
    <p><strong>Espécie:</strong> @Model.Especie</p>
    <p><strong>Raça:</strong> @Model.Raca</p>
    <p><strong>Idade:</strong> @Model.Idade</p>

    <form asp-action="Delete">
        <input type="hidden" asp-for="AnimalId" />

        <button type="submit" style="background:red;">
            Confirmar Exclusão
        </button>
    </form>

    <a asp-action="Index">Cancelar</a>
</div>

<style>
    body {
        font-family: Arial;
        background-color: #f4f6f9;
    }

    .box {
        background: white;
        padding: 25px;
        margin: 40px auto;
        width: 350px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    h1 {
        text-align: center;
    }

    p {
        margin: 8px 0;
    }

    button {
        width: 100%;
        margin-top: 15px;
        padding: 10px;
        border: none;
        border-radius: 6px;
        background: red;
        color: white;
        font-weight: bold;
        cursor: pointer;
    }

        button:hover {
            background: darkred;
        }

    a {
        display: block;
        text-align: center;
        margin-top: 10px;
    }
</style>