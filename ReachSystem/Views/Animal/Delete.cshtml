@model ReachSystem.Models.Animal

<div class="box">
    <h1>Excluir Animal</h1>

    <p>Tem certeza que deseja excluir <strong>@Model.Nome</strong>?</p>

    <form asp-action="Delete">
        <input type="hidden" asp-for="AnimalId" />
        <button type="submit" class="btn-delete">Confirmar</button>
    </form>

    <a asp-action="Index" class="btn btn-edit">Cancelar</a>
</div>