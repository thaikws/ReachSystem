@model ReachSystem.Models.FichaSaude

<div class="container mt-5" style="max-width: 800px;">

    <div class="card shadow border-0 rounded-4">

        <div class="card-header text-white rounded-4"
             style="background-color:#8DB6D9;">

            <h2 class="mb-0">
                Ficha de Saúde
            </h2>

        </div>

        <div class="card-body">

            <div class="mb-3">
                <strong>ID:</strong> @Model.FichaSaudeId
            </div>

            <div class="mb-3">
                <strong>Animal ID:</strong> @Model.AnimalId
            </div>

            <div class="mb-3">
                <strong>Descrição:</strong> @Model.Descricao
            </div>

            <div class="mb-3">
                <strong>Vacinas:</strong> @Model.Vacinas
            </div>

            <div class="mb-3">
                <strong>Alergias:</strong> @Model.Alergias
            </div>

            <div class="mb-3">
                <strong>Doenças:</strong> @Model.DoencasPreExistentes
            </div>

            <div class="mb-3">
                <strong>Medicamentos:</strong> @Model.Medicamentos
            </div>

            <a asp-controller="Animal"
               asp-action="Details"
               asp-route-id="@Model.AnimalId"
               class="btn btn-light border rounded-3">
                Voltar para o Animal
            </a>

            <a asp-action="Index"
               class="btn text-white rounded-3"
               style="background-color:#8DB6D9;">
                Ver Todas as Fichas
            </a>

        </div>

    </div>

</div>