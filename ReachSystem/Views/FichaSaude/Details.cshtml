@model ReachSystem.Models.FichaSaude

<style>
    body {
        background: #F4F7FB;
        font-family: 'Public Sans', sans-serif;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Sora', sans-serif;
    }

    .page-title {
        color: #173746;
        font-weight: 700;
    }

    .card-custom {
        background: #FFFFFF;
        border: none;
        border-radius: 18px;
        overflow: hidden;
    }

    .card-header-custom {
        background: #2C5D7C;
        color: #FFFFFF;
        padding: 18px 24px;
    }

        .card-header-custom h2 {
            margin: 0;
            font-weight: 600;
            font-size: 1.6rem;
        }

    /* Card do Animal */

    .animal-card {
        background: #FFFFFF;
        border: 1px solid #E6EDF5;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 3px 10px rgba(0,0,0,.05);
        height: 100%;
    }

    .animal-img {
        width: 150px;
        height: 210px;
        object-fit: cover;
        border-radius: 14px;
        border: 3px solid #E6EDF5;
        background: #E6EDF5;
        margin-bottom: 18px;
    }

    .animal-card h4 {
        color: #173746;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .animal-card small {
        color: #6C7A89;
    }

    /* Informações */

    .info-card {
        background: #FFFFFF;
        border: 1px solid #E6EDF5;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 3px 10px rgba(0,0,0,.04);
        text-align: left;
    }

        .info-card h6 {
            color: #2C5D7C;
            font-weight: 700;
            margin-bottom: 15px;
            text-align: left;
        }

        .info-card p {
            color: #173746;
            line-height: 1.6;
            margin: 0;
            white-space: pre-wrap;
            text-align: left;
        }

        .info-card hr {
            border-color: #E6EDF5;
            margin: .7rem 0;
        }

    /* Botões */

    .btn-primary-custom {
        background: #2C5D7C;
        color: #FFFFFF;
        border: none;
    }

        .btn-primary-custom:hover {
            background: #234B64;
            color: #FFFFFF;
        }

    .btn-outline-custom {
        border: 1px solid #1B6EC2;
        color: #1B6EC2;
        background: #FFFFFF;
    }

        .btn-outline-custom:hover {
            background: #1B6EC2;
            color: #FFFFFF;
        }

    @@media (max-width:768px) {

        body {
            overflow-x: hidden;
        }
        /* Card principal */

        .card-body {
            padding: 18px !important;
        }
        /* Header */

        .card-header-custom {
            padding: 15px 18px;
        }

            .card-header-custom h2 {
                font-size: 1.3rem;
            }
        /* Animal */

        .animal-card {
            padding: 18px 12px;
            margin-bottom: 20px;
        }

        .animal-img {
            width: 150px;
            height: 200px;
        }


        .animal-card h4 {
            font-size: 1.2rem;
        }
        /* Informações */

        .info-card {
            padding: 15px;
            text-align: left;
        }

            .info-card h6 {
                font-size: .95rem;
            }

            .info-card p {
                font-size: .9rem;
                text-align: left;
                word-break: break-word;
            }
        /* Botões igual Animal Details */

        .d-flex.gap-2.mt-4 {
            flex-direction: column;
            gap: 10px !important;
        }


        .btn-primary-custom,
        .btn-outline-custom {
            width: 100%;
            padding: .65rem 1rem;
        }
    }
</style>
<div class="container py-5">

    <div class="mb-4">

        <h2 class="page-title">
            Detalhes da Ficha de Saúde
        </h2>

        <small class="text-muted">
            Visualização completa das informações médicas do animal.
        </small>

    </div>

    <div class="card card-custom shadow-sm">

        <div class="card-header card-header-custom">
            <h2>Ficha de Saúde</h2>
        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <!-- Animal -->

                <div class="col-lg-3">

                    <div class="animal-card">

                        <img src="@Model.Animal?.Foto"
                             class="animal-img"
                             alt="@Model.Animal?.Nome"
                             onerror="this.style.display='none'" />

                        <h4>@Model.Animal?.Nome</h4>

                        <small>
                            Animal #@Model.AnimalId
                        </small>

                    </div>

                </div>

                <!-- Informações -->

                <div class="col-lg-9">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="info-card">

                                <h6>Alergias</h6>

                                <hr />

                                <p>
                                    @(string.IsNullOrWhiteSpace(Model.Alergias)
                                        ? "Nenhuma informação cadastrada."
                                        : Model.Alergias)
                                </p>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="info-card">

                                <h6>Vacinas</h6>

                                <hr />

                                <p>
                                    @(string.IsNullOrWhiteSpace(Model.Vacinas)
                                        ? "Nenhuma informação cadastrada."
                                        : Model.Vacinas)
                                </p>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="info-card">

                                <h6>Doenças Pré-existentes</h6>

                                <hr />

                                <p>
                                    @(string.IsNullOrWhiteSpace(Model.DoencasPreExistentes)
                                        ? "Nenhuma informação cadastrada."
                                        : Model.DoencasPreExistentes)
                                </p>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="info-card">

                                <h6>Medicamentos</h6>

                                <hr />

                                <p>
                                    @(string.IsNullOrWhiteSpace(Model.Medicamentos)
                                        ? "Nenhuma informação cadastrada."
                                        : Model.Medicamentos)
                                </p>

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="info-card">

                                <h6>Descrição</h6>

                                <hr />

                                <p>
                                    @(string.IsNullOrWhiteSpace(Model.Descricao)
                                        ? "Nenhuma descrição cadastrada."
                                        : Model.Descricao)
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Botões -->

            <div class="d-flex gap-2 mt-4">

                <a asp-action="Index"
                   class="btn btn-primary-custom">
                    Ver Todas as Fichas
                </a>

                <a asp-controller="Animal"
                   asp-action="Details"
                   asp-route-id="@Model.AnimalId"
                   class="btn btn-outline-custom">
                    Voltar para o Animal
                </a>

            </div>

        </div>

    </div>

</div>