@model ReachSystem.Models.FichaSaude

<style>
    .animal-preview {
        display: flex;
        gap: 15px;
        align-items: center;
        padding: 12px;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 20px;
    }

    .animal-img {
        width: 120px;
        height: 180px;
        object-fit: cover;
        border-radius: 12px;
    }

    .animal-info h5 {
        margin: 0;
        color: #2C5D7C;
    }

    .animal-info small {
        color: #777;
    }

    .form-section {
        margin-bottom: 12px;
    }

        .form-section label {
            font-weight: 600;
            
            margin-bottom: 5px;
        }
</style>

<div style="background-color:#F4F7FB; min-height:100vh; padding:30px 0;">

    <div class="container mt-4" style="max-width: 800px;">

        <div class="card shadow border-0 rounded-4">

            <!-- HEADER -->
            <div class="card-header text-white"
                 style="background-color:#2C5D7C;">
                <h4 class="mb-0">Editar Ficha de Saúde</h4>
            </div>

            <div class="card-body">

                <form asp-action="Update" method="post">

                    <input type="hidden" asp-for="FichaSaudeId" />
                    <input type="hidden" asp-for="AnimalId" />

                    <!-- ANIMAL -->
                    <div class="animal-preview">

                        <img src="@Model.Animal?.Foto"
                             class="animal-img"
                             style="width:110px;height:170px;" />

                        <div>
                            <h5>@Model.Animal?.Nome</h5>
                            <small>ID: @Model.AnimalId</small>
                        </div>

                    </div>

                    <!-- DESCRIÇÃO -->
                    <div class="form-section">
                        <label>Descrição / Observações</label>
                        <textarea asp-for="Descricao"
                                  class="form-control"
                                  rows="3"></textarea>
                    </div>

                    <!-- VACINAS -->
                    <div class="form-section">
                        <label>Vacinas</label>
                        <input asp-for="Vacinas"
                               class="form-control" />
                    </div>

                    <!-- ALERGIAS -->
                    <div class="form-section">
                        <label>Alergias</label>
                        <input asp-for="Alergias"
                               class="form-control" />
                    </div>

                    <!-- DOENÇAS -->
                    <div class="form-section">
                        <label>Doenças pré-existentes</label>
                        <input asp-for="DoencasPreExistentes"
                               class="form-control" />
                    </div>

                    <!-- MEDICAMENTOS -->
                    <div class="form-section">
                        <label>Medicamentos</label>
                        <textarea asp-for="Medicamentos"
                                  class="form-control"
                                  rows="3"></textarea>
                    </div>

                    <!-- BOTÕES -->
                    <div class="mt-3 d-flex gap-2">

                        <button type="submit"
                                class="btn text-white"
                                style="background-color:#2C5D7C;">
                            Atualizar
                        </button>

                        <a asp-action="Index"
                           class="btn btn-light border">
                            Voltar
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>