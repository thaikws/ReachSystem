
@model IEnumerable<ReachSystem.Models.FichaSaude>

<style>
    body {
        background: #F4F7FB;
        font-family: 'Public Sans', sans-serif;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Sora', sans-serif;
    }

    .card-ficha {
        transition: .2s;
        border-radius: 20px !important;
        overflow: hidden;
    }

    .card-ficha:hover {
        transform: translateY(-4px);
    }
</style>
        

<div class="container-fluid px-5 py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0" style="color:#173746;">
                Fichas de Saúde
            </h2>
            <small style="color:#6C7A89;">
                Visão geral dos registros
            </small>
        </div>

        <a asp-action="Create"
           class="btn text-white shadow-sm"
           style="background:#2C5D7C;">
            + Nova Ficha
        </a>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <small>Total de Fichas</small>
                    <h3 class="fw-bold">
                        @Model.Count()
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <small>Último ID</small>

                    <h3 class="fw-bold">

                        @{
                            int ultimoId = 0;

                            foreach (var ficha in Model)
                            {
                                if (ficha.FichaSaudeId > ultimoId)
                                {
                                    ultimoId = ficha.FichaSaudeId;
                                }
                            }
                        }

                        @ultimoId

                    </h3>

                </div>
            </div>
        </div>

    </div>

    
    <div class="row g-3">

        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                <div class="card card-ficha shadow-sm border-0 h-100 rounded-4">

                 
                    <div class="card-header text-white py-2 border-0"
                         style="background:#2C5D7C;">

                        <div class="d-flex align-items-center">

                            <img src="@item.Animal?.Foto"
                                 alt="@item.Animal?.Nome"
                                 onerror="this.style.display='none'"
                                 style="width:45px;
                            height:45px;
                            border-radius:50%;
                            object-fit:cover;
                            border:2px solid white;" />

                            <div class="ms-2">

                                <div class="fw-bold">
                                    @item.Animal?.Nome
                                </div>

                                <small>
                                    Ficha #@item.FichaSaudeId
                                </small>

                            </div>

                        </div>

                    </div>

                    <div class="card-body p-3">

                        <div class="mb-2">

                            <strong>Descrição</strong>

                            <div class="text-muted small">

                                @(string.IsNullOrEmpty(item.Descricao)
                                    ? "-"
                                    : item.Descricao.Length > 50
                                        ? item.Descricao.Substring(0, 50) + "..."
                                        : item.Descricao)

                            </div>

                        </div>

                        <div class="mb-3">

                            <strong>Vacinas</strong>

                            <div class="text-muted small">

                                @(string.IsNullOrEmpty(item.Vacinas)
                                    ? "-"
                                    : item.Vacinas.Length > 50
                                        ? item.Vacinas.Substring(0, 50) + "..."
                                        : item.Vacinas)

                            </div>

                        </div>

                        <div class="d-grid gap-1">

                            <a asp-action="Details"
                               asp-route-id="@item.FichaSaudeId"
                               class="btn btn-sm btn-outline-primary">
                                Ver
                            </a>

                            <a asp-action="Update"
                               asp-route-id="@item.FichaSaudeId"
                               class="btn btn-sm text-white"
                               style="background:#2C5D7C;">
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.FichaSaudeId"
                               class="btn btn-sm btn-danger">
                                Excluir
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>