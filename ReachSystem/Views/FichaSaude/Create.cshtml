@model ReachSystem.Models.FichaSaude

<h2>Nova Ficha de Saúde</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="AnimalId" class="form-label"></label>
        <input asp-for="AnimalId" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label"></label>
        <textarea asp-for="Descricao" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Vacinas" class="form-label"></label>
        <input asp-for="Vacinas" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Alergias" class="form-label"></label>
        <input asp-for="Alergias" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="DoencasPreExistentes" class="form-label"></label>
        <input asp-for="DoencasPreExistentes" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Medicamentos" class="form-label"></label>
        <textarea asp-for="Medicamentos" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">
        Salvar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Voltar
    </a>

</form>