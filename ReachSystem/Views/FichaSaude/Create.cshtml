@model ReachSystem.Models.FichaSaude

<div class="container mt-5" style="max-width: 800px;">

    <div class="card shadow border-0 rounded-4">

        <div class="card-header text-white rounded-4"
             style="background-color:#8DB6D9;">

            <h2 class="mb-0">
                Ficha de Saúde
            </h2>

        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label asp-for="AnimalId" class="form-label">
                        Animal
                    </label>

            <select asp-for="AnimalId" class="form-select rounded-3">
                <option value="">Selecione um animal</option>

                    @foreach (var animal in ViewBag.Animais)
                    {
                        <option value="@animal.AnimalId">
                            @animal.Nome
                        </option>
                    }
            </select>

            <span asp-validation-for="AnimalId" class="text-danger"></span>
        </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label"></label>
                    <textarea asp-for="Descricao"
                              class="form-control rounded-3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Vacinas" class="form-label"></label>
                    <input asp-for="Vacinas"
                           class="form-control rounded-3" />
                </div>

                <div class="mb-3">
                    <label asp-for="Alergias" class="form-label"></label>
                    <input asp-for="Alergias"
                           class="form-control rounded-3" />
                </div>

                <div class="mb-3">
                    <label asp-for="DoencasPreExistentes" class="form-label"></label>
                    <input asp-for="DoencasPreExistentes"
                           class="form-control rounded-3" />
                </div>

                <div class="mb-3">
                    <label asp-for="Medicamentos" class="form-label"></label>
                    <textarea asp-for="Medicamentos"
                              class="form-control rounded-3"></textarea>
                </div>

                <button type="submit"
                        class="btn text-white rounded-3"
                        style="background-color:#8DB6D9;">
                    Salvar
                </button>

                <a asp-action="Index"
                   class="btn btn-light border rounded-3">
                    Voltar
                </a>

            </form>

        </div>

    </div>

</div>