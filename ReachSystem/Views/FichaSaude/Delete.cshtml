@model ReachSystem.Models.FichaSaude

<h2>Excluir Ficha de Saúde</h2>

<div class="alert alert-danger">
    Tem certeza que deseja excluir esta ficha?
</div>

<div class="mb-3">
    <strong>ID:</strong> @Model.FichaSaudeId
</div>

<div class="mb-3">
    <strong>Animal ID:</strong> @Model.AnimalId
</div>

<div class="mb-3">
    <strong>Descrição:</strong> @Model.Descricao
</div>

<div class="mb-3">
    <strong>Vacinas:</strong> @Model.Vacinas
</div>

<div class="mb-3">
    <strong>Alergias:</strong> @Model.Alergias
</div>

<div class="mb-3">
    <strong>Doenças Pré-existentes:</strong> @Model.DoencasPreExistentes
</div>

<div class="mb-3">
    <strong>Medicamentos:</strong> @Model.Medicamentos
</div>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="FichaSaudeId" />

    <button type="submit" class="btn btn-danger">
        Confirmar Exclusão
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>