@model ReachSystem.Models.Evento

@{
    ViewData["Title"] = "Novo Evento";
}

<div class="container py-4 form-narrow">

    <h2 class="page-title mb-4">
        Cadastrar Evento
    </h2>

    <div class="card card-custom shadow-sm">

        <div class="card-header-custom">
            <h4>Novo Evento</h4>
        </div>

        <div class="card-body p-4">

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">Nome</label>
                    <input asp-for="Nome" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Data" class="form-label">Data</label>
                    <input asp-for="Data" type="datetime-local" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Local" class="form-label">Local</label>
                    <input asp-for="Local" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label">Descrição</label>
                    <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-back-custom">
                        Voltar
                    </a>

                    <button type="submit"
                            class="btn btn-primary-custom px-4">
                        Salvar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<style>
    body {
        background: #F4F7FB;
        font-family: 'Public Sans', sans-serif;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Sora', sans-serif;
    }

    .form-narrow {
        max-width: 760px;
    }

    .page-title {
        color: #173746;
        font-weight: 700;
    }

    .card-custom {
        background: #FFFFFF;
        border: none;
        border-radius: 18px;
        overflow: hidden;
    }

    .card-header-custom {
        background: #2C5D7C;
        color: #FFFFFF;
        padding: 18px 24px;
    }

        .card-header-custom h4 {
            margin: 0;
            font-weight: 600;
        }

    .card-body {
        overflow: hidden;
    }

    .form-label {
        color: #173746;
        font-weight: 600;
    }

    .form-control {
        border: 1px solid #E6EDF5;
        background: #FFFFFF;
        border-radius: 10px;
        padding: 10px 14px;
        height: 48px;
    }

        .form-control:focus {
            border-color: #2C5D7C;
            box-shadow: 0 0 0 .2rem rgba(44,93,124,.15);
        }

    textarea.form-control {
        height: auto;
    }

    .btn-primary-custom,
    .btn-back-custom {
        border-radius: 10px;
        padding: .6rem 1.5rem;
        font-weight: 600;
    }

    .btn-primary-custom {
        background: #2C5D7C;
        color: #FFFFFF;
        border: none;
    }

        .btn-primary-custom:hover {
            background: #234B64;
            color: #FFFFFF;
        }

    .btn-back-custom {
        background: #ECEFF3;
        color: #173746;
        border: none;
    }

        .btn-back-custom:hover {
            background: #DDE5EE;
            color: #173746;
        }

    @@media (max-width:768px) {
        .card-body {
            padding: 1.5rem;
        }
    }
</style>