@model ReachSystem.DTOs.ConsultaDto

@{
    ViewData["Title"] = "Nova Consulta";
}

<div class="container py-4 form-narrow">

    <h2 class="page-title mb-4">
        Cadastrar Consulta
    </h2>

    <div class="card card-custom shadow-sm">

        <div class="card-header-custom">
            <h4>Nova Consulta</h4>
        </div>

        <div class="card-body p-4">

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="AnimalId" class="form-label"></label>

                    <select asp-for="AnimalId" id="animalSelect" class="form-select">
                        <option value="">Selecione um animal</option>

                        @foreach (var animal in ViewBag.Animais)
                        {
                            <option value="@animal.AnimalId"
                                    data-foto="@animal.Foto"
                                    data-nome="@animal.Nome">
                                @animal.Nome
                            </option>
                        }
                    </select>

                    <span asp-validation-for="AnimalId" class="text-danger"></span>
                </div>

                <div class="animal-preview mb-3">
                    <img id="animalPreview"
                         src="/images/no-image.png"
                         alt="Animal" />

                    <div>
                        <h5 id="animalNome">Selecione um animal</h5>
                        <small>Pré-visualização</small>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Data" class="form-label"></label>

                    <input asp-for="Data"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="Data" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label"></label>

                    <textarea asp-for="Descricao"
                              rows="5"
                              class="form-control"></textarea>

                    <span asp-validation-for="Descricao"
                          class="text-danger"></span>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2 buttons">

                    <a asp-action="Index"
                       class="btn btn-back-custom">
                        Voltar
                    </a>

                    <button type="submit"
                            class="btn btn-primary-custom px-4">
                        Salvar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<style>
    body {
        background: #F4F7FB;
        font-family: 'Public Sans', sans-serif;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Sora', sans-serif;
    }

    .form-narrow {
        max-width: 760px;
    }

    .page-title {
        color: #173746;
        font-weight: 700;
    }

    .card-custom {
        background: #FFFFFF;
        border: none;
        border-radius: 18px;
        overflow: hidden;
    }

    .card-header-custom {
        background: #2C5D7C;
        color: #FFFFFF;
        padding: 18px 24px;
    }

        .card-header-custom h4 {
            margin: 0;
            font-weight: 600;
        }

    .card-body {
        overflow: hidden;
    }

    .form-label {
        color: #173746;
        font-weight: 600;
    }

    .form-control,
    .form-select {
        border: 1px solid #E6EDF5;
        background-color: #FFFFFF;
        border-radius: 10px;
        padding: 10px 14px;
        height: 48px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #2C5D7C;
            box-shadow: 0 0 0 .2rem rgba(44,93,124,.15);
        }

    textarea.form-control {
        height: auto;
        min-height: 120px;
        resize: vertical;
    }

    .animal-preview {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 16px;
        background: #F8FAFC;
        border: 1px solid #E6EDF5;
        border-radius: 16px;
    }

        .animal-preview img {
            width: 90px;
            height: 90px;
            border-radius: 12px;
            object-fit: cover;
            background: #E5E7EB;
            flex-shrink: 0;
        }

        .animal-preview h5 {
            margin: 0;
            color: #173746;
            font-weight: 600;
        }

        .animal-preview small {
            color: #6C7A89;
        }

    .btn-primary-custom,
    .btn-back-custom {
        border-radius: 10px;
        padding: .6rem 1.5rem;
        font-weight: 600;
    }

    .btn-primary-custom {
        background: #2C5D7C;
        color: #FFFFFF;
        border: none;
    }

        .btn-primary-custom:hover {
            background: #234B64;
            color: #FFFFFF;
        }

    .btn-back-custom {
        background: #ECEFF3;
        color: #173746;
        border: none;
    }

        .btn-back-custom:hover {
            background: #DDE5EE;
            color: #173746;
        }

    @@media (max-width:768px) {

        .card-body {
            padding: 1.5rem;
        }

        .animal-preview {
            flex-direction: column;
            text-align: center;
            gap: 12px;
            padding: 14px;
        }

        .buttons {
            flex-direction: column-reverse;
        }

            .buttons .btn {
                width: 100%;
            }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const select = document.getElementById("animalSelect");
        const preview = document.getElementById("animalPreview");
        const nome = document.getElementById("animalNome");

        select.addEventListener("change", function () {

            const option = this.options[this.selectedIndex];

            if(option.value === ""){
                preview.src="/images/no-image.png";
                nome.textContent="Selecione um animal";
                return;
            }

            nome.textContent = option.dataset.nome;

            if(option.dataset.foto){
                preview.src = option.dataset.foto;
            }else{
                preview.src="/images/no-image.png";
            }

        });
    </script>
}