@model ReachSystem.Models.Consulta

@{
    ViewBag.Title = "Excluir Consulta";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center align-items-center" style="min-height: calc(80vh - 180px);">
        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-header text-center bg-danger text-white">
                    <strong>Excluir consulta</strong>
                </div>

                <div class="card-body">

                    <h5 class="mb-3 text-center">Tem certeza que deseja excluir esta consulta?</h5>

                    <dl class="row">
                        <dt class="col-sm-4">Animal</dt>
                        <dd class="col-sm-8">@Model.Animal?.Nome</dd>

                        <dt class="col-sm-4">Data e hora</dt>
                        <dd class="col-sm-8">@Model.Data</dd>

                        <dt class="col-sm-4">Descrição</dt>
                        <dd class="col-sm-8">@Model.Descricao</dd>
                    </dl>

                    @using (Html.BeginForm("Delete", "Consulta", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ConsultaID)
                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-danger">Excluir</button>
                            <a href="@Url.Action("Index", "Consulta")" class="btn btn-secondary ms-2">Cancelar</a>
                        </div>
                    }

                </div>

            </div>

        </div>
    </div>
</div>