@model ReachSystem.Models.Consulta

@{
    ViewData["Title"] = "Excluir Consulta";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm border-danger">

                <!-- HEADER -->
                <div class="card-header bg-danger text-white text-center">

                    <h4 class="mb-0">
                        Excluir Consulta
                    </h4>

                </div>

                <!-- BODY -->
                <div class="card-body">

                    <!-- ALERTA -->
                    <div class="alert alert-danger">

                        Tem certeza que deseja excluir esta consulta?

                    </div>

                    <!-- INFORMAÇÕES -->
                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            ID da Consulta
                        </label>

                        <input class="form-control"
                               value="@Model.ConsultaID"
                               readonly />

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Animal ID
                        </label>

                        <input class="form-control"
                               value="@Model.AnimalId"
                               readonly />

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Data
                        </label>

                        <input class="form-control"
                               value="@Model.Data"
                               readonly />

                    </div>

                    <div class="mb-4">

                        <label class="form-label fw-bold">
                            Descrição
                        </label>

                        <textarea class="form-control"
                                  rows="5"
                                  readonly>@Model.Descricao</textarea>

                    </div>

                    <!-- FORM -->
                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- ID -->
                        <input type="hidden"
                               name="id"
                               value="@Model.ConsultaID" />

                        <!-- BOTÕES -->
                        <div class="d-flex justify-content-end">

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                Cancelar

                            </a>

                            <button type="submit"
                                    class="btn btn-danger ms-2">

                                Excluir Consulta

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>