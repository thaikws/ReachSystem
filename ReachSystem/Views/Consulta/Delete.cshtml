@model ReachSystem.DTOs.ConsultaDto

@{
    ViewData["Title"] = "Excluir Consulta";
}

<style>
    body {
        background: #f4f7fb;
    }
</style>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow border-danger">

                <!-- HEADER -->
                <div class="card-header bg-danger text-white text-center">

                    <h4 class="mb-0">
                        Excluir Consulta
                    </h4>

                </div>

                <!-- BODY -->
                <div class="card-body">

                    <!-- ALERTA -->
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Tem certeza que deseja excluir essa consulta?
                    </div>

                    <!-- DADOS -->
                    <div class="mb-3">

                        <label class="fw-bold">
                            ID da Consulta
                        </label>

                        <input class="form-control"
                               value="@Model.ConsultaID"
                               readonly />

                    </div>

                    <div class="mb-3">

                        <label class="fw-bold">
                            Animal ID
                        </label>

                        <input class="form-control"
                               value="@Model.AnimalId"
                               readonly />

                    </div>

                    <div class="mb-3">

                        <label class="fw-bold">
                            Data
                        </label>

                        <input class="form-control"
                               value="@Model.Data.ToString("dd/MM/yyyy HH:mm")"
                               readonly />

                    </div>

                    <div class="mb-4">

                        <label class="fw-bold">
                            Descrição
                        </label>

                        <textarea class="form-control"
                                  rows="5"
                                  readonly>@Model.Descricao</textarea>

                    </div>

                    <!-- FORM -->
                    <form asp-action="Delete"
                          asp-route-id="@Model.ConsultaID"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="d-flex justify-content-end">

                            <!-- CANCELAR -->
                            <a asp-action="Index"
                               class="btn btn-secondary">

                                Cancelar

                            </a>

                            <!-- EXCLUIR -->
                            <button type="submit"
                                    class="btn btn-danger ms-2">

                                <i class="bi bi-trash"></i>
                                Excluir

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>