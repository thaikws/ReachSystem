@{
    var consultasPorDia = new Dictionary<int, List<ReachSystem.Models.Consulta>>();

    if (Model != null)
    {
        foreach (var c in Model)
        {
            DateTime dataConvertida;

            // tenta converter string para data
            if (DateTime.TryParse(c.Data, out dataConvertida))
            {
                int dia = dataConvertida.Day;

                if (!consultasPorDia.ContainsKey(dia))
                    consultasPorDia[dia] = new List<ReachSystem.Models.Consulta>();

                consultasPorDia[dia].Add(c);
            }
        }
    }
}

<div class="card shadow-sm">
    <div class="card-header text-center">
        <strong>@DateTime.Now.ToString("MMMM yyyy")</strong>
    </div>

    <div class="card-body">

        <div class="row text-center">

            @for (int i = 1; i <= 31; i++)
            {
                var temConsulta = consultasPorDia.ContainsKey(i);

                    <div class="col-2 border p-2"
                         style="cursor:pointer;
                            background-color:@(temConsulta ? "#b6e3b6" : "#f8f9fa");"
                         onclick="mostrarConsultas(@i)">

                        <strong>@i</strong>

                    @if (temConsulta)
                    {
                                <div>
                                    <small>@consultasPorDia[i].Count consulta(s)</small>
                                </div>
                    }
                    </div>
            }

        </div>

    </div>
</div>

<!-- LISTA DINÂMICA -->
<div id="consultasDoDia" class="mt-3"></div>

<script>
    const consultas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

    function mostrarConsultas(dia) {

        let html = `<h5>Consultas do dia ${dia}</h5>`;

        let filtradas = consultas.filter(c => {
            let data = new Date(c.data);
            return data.getDate() === dia;
        });

        if (filtradas.length === 0) {
            html += "<p>Nenhuma consulta</p>";
        } else {
            filtradas.forEach(c => {
                html += `
                    <div class="card mb-2 p-2">
                        <strong>ID:</strong> ${c.consultaID}<br/>
                        <strong>Descrição:</strong> ${c.descricao}
                    </div>
                `;
            });
        }

        document.getElementById("consultasDoDia").innerHTML = html;
    }
</script>