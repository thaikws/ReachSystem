@model IEnumerable<ReachSystem.Models.Consulta>

@{
    var consultas = Model;
}

<div class="container-fluid mt-4">

    <div class="row">

        <!-- LISTA -->
        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <h5 class="mb-0">
                        Consultas
                    </h5>

                    <button class="btn btn-sm btn-outline-primary"
                            onclick="mostrarTodasConsultas()">

                        Mostrar Todas

                    </button>

                </div>

                <div class="card-body"
                     style="height:700px; overflow-y:auto;">

                    <div id="consultasDoDia"></div>

                </div>

            </div>

        </div>

        <!-- CALENDÁRIO -->
        <div class="col-md-8">

            <div class="card shadow-sm">

                <!-- HEADER -->
                <div class="card-header">

                    <div class="d-flex justify-content-between align-items-center">

                        <!-- BOTÃO ESQUERDA -->
                        <button class="btn btn-outline-secondary"
                                onclick="mudarMes(-1)">

                            <i class="bi bi-caret-left"></i>

                        </button>

                        <!-- CENTRO -->
                        <div class="d-flex align-items-center gap-2">

                            <!-- BOTÃO HOJE -->
                            <button class="btn btn-outline-dark btn-sm"
                                    onclick="irParaHoje()"
                                    title="Voltar para o mês atual">

                                <i class="bi bi-calendar-event"></i>
                                Hoje

                            </button>

                            <h5 class="mb-0 text-capitalize">
                                <span id="mesAtual"></span>
                            </h5>

                            <select id="selectMes"
                                    class="form-select form-select-sm"
                                    style="width:160px;"
                                    onchange="alterarData()">

                                <option value="0">Janeiro</option>
                                <option value="1">Fevereiro</option>
                                <option value="2">Março</option>
                                <option value="3">Abril</option>
                                <option value="4">Maio</option>
                                <option value="5">Junho</option>
                                <option value="6">Julho</option>
                                <option value="7">Agosto</option>
                                <option value="8">Setembro</option>
                                <option value="9">Outubro</option>
                                <option value="10">Novembro</option>
                                <option value="11">Dezembro</option>

                            </select>

                            <select id="selectAno"
                                    class="form-select form-select-sm"
                                    style="width:100px;"
                                    onchange="alterarData()">
                            </select>

                        </div>

                        <!-- BOTÃO DIREITA -->
                        <button class="btn btn-outline-secondary"
                                onclick="mudarMes(1)">

                            <i class="bi bi-caret-right"></i>

                        </button>

                    </div>

                </div>

                <!-- DIAS DA SEMANA -->
                <div class="row text-center fw-bold border-bottom m-0">

                    <div class="col p-2">Dom</div>
                    <div class="col p-2">Seg</div>
                    <div class="col p-2">Ter</div>
                    <div class="col p-2">Qua</div>
                    <div class="col p-2">Qui</div>
                    <div class="col p-2">Sex</div>
                    <div class="col p-2">Sáb</div>

                </div>

                <!-- CALENDÁRIO -->
                <div class="card-body p-0">

                    <div id="calendario"
                         class="d-flex flex-wrap text-center">
                    </div>

                </div>

            </div>

            <!-- BOTÕES -->
            <div class="d-flex justify-content-end gap-2 mt-3">

                <a asp-action="Create"
                   class="btn btn-success">

                    Adicionar

                </a>

                <a href="#"
                   onclick="ativarModoDelete(); return false;"
                   class="btn btn-danger">

                    Excluir

                </a>

                <a href="#"
                   onclick="desativarModoDelete(); return false;"
                   class="btn btn-secondary">

                    Cancelar

                </a>

            </div>

        </div>

    </div>

</div>

<script>

    const consultas = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(Model)
    );

    let dataAtual = new Date();

    let modoDelete = false;

    // =========================================
    // CARREGAR ANOS
    // =========================================
    function carregarAnos() {

        const selectAno =
            document.getElementById("selectAno");

        selectAno.innerHTML = "";

        for (let ano = 2020; ano <= 2035; ano++) {

            selectAno.innerHTML += `
                <option value="${ano}">
                    ${ano}
                </option>
            `;
        }
    }

    // =========================================
    // ALTERAR DATA
    // =========================================
    function alterarData() {

        const mes =
            parseInt(
                document.getElementById("selectMes").value
            );

        const ano =
            parseInt(
                document.getElementById("selectAno").value
            );

        dataAtual.setMonth(mes);

        dataAtual.setFullYear(ano);

        renderizarCalendario();

        mostrarTodasConsultas();
    }

    // =========================================
    // RENDERIZAR CALENDÁRIO
    // =========================================
    function renderizarCalendario() {

        const mes = dataAtual.getMonth();
        const ano = dataAtual.getFullYear();

        document.getElementById("selectMes").value = mes;
        document.getElementById("selectAno").value = ano;

        document.getElementById("mesAtual").innerText =
            dataAtual.toLocaleString(
                'pt-BR',
                {
                    month: 'long',
                    year: 'numeric'
                }
            );

        const primeiroDia =
            new Date(ano, mes, 1).getDay();

        const diasNoMes =
            new Date(ano, mes + 1, 0).getDate();

        const diasMesAnterior =
            new Date(ano, mes, 0).getDate();

        let html = "";

        // =====================================
        // DIAS MÊS ANTERIOR
        // =====================================
        for (let i = primeiroDia - 1; i >= 0; i--) {

            const diaAnterior =
                diasMesAnterior - i;

            html += `
                <div
                    class="border text-muted"

                    style="
                        width:14.28%;
                        height:100px;
                        background:#f5f5f5;
                        opacity:0.5;
                        padding:10px;
                    ">

                    <strong>${diaAnterior}</strong>

                </div>
            `;
        }

        // =====================================
        // DIAS MÊS ATUAL
        // =====================================
        for (let dia = 1; dia <= diasNoMes; dia++) {

            let temConsulta = consultas.some(c => {

                let d = new Date(c.data);

                return d.getDate() === dia &&
                       d.getMonth() === mes &&
                       d.getFullYear() === ano;
            });

            const hoje = new Date();

            const ehHoje =
                dia === hoje.getDate() &&
                mes === hoje.getMonth() &&
                ano === hoje.getFullYear();

                let corFundo = "#ffffff";
                let estiloExtra = "";

                if (ehHoje) {

                    corFundo = "rgba(189, 209, 222, 0.7)";
                    estiloExtra = `
                        border:2px solid #4dabf7;
                        font-weight:bold;
                    `;

                }
                else if (temConsulta) {

                    corFundo = "#b6e3b6";

                }

            html += `
                <div
                    class="border"

                        style="
                            width:14.28%;
                            height:100px;
                            cursor:pointer;
                            background:${corFundo};
                            padding:10px;
                            ${estiloExtra}
                        "

                    onclick="mostrarConsultas(${dia})">

                    <strong>${dia}</strong>

                </div>
            `;
        }

        // =====================================
        // DIAS PRÓXIMO MÊS
        // =====================================
        const total =
            primeiroDia + diasNoMes;

        const resto = total % 7;

        if (resto !== 0) {

            const faltando = 7 - resto;

            for (let i = 1; i <= faltando; i++) {

                html += `
                    <div
                        class="border text-muted"

                        style="
                            width:14.28%;
                            height:100px;
                            background:#f5f5f5;
                            opacity:0.5;
                            padding:10px;
                        ">

                        <strong>${i}</strong>

                    </div>
                `;
            }
        }

        document.getElementById(
            "calendario"
        ).innerHTML = html;
    }

    // =========================================
    // TROCAR MÊS
    // =========================================
    function mudarMes(valor) {

        dataAtual.setMonth(
            dataAtual.getMonth() + valor
        );

        renderizarCalendario();

        mostrarTodasConsultas();
    }

    // =========================================
    // DELETE
    // =========================================
    function ativarModoDelete() {

        modoDelete = true;

        mostrarTodasConsultas();
    }

    function desativarModoDelete() {

        modoDelete = false;

        mostrarTodasConsultas();
    }

    // =========================================
    // MOSTRAR TODAS CONSULTAS
    // =========================================
    function mostrarTodasConsultas() {

        const mes = dataAtual.getMonth();
        const ano = dataAtual.getFullYear();

        let consultasMes = consultas.filter(c => {

            let d = new Date(c.data);

            return d.getMonth() === mes &&
                   d.getFullYear() === ano;
        });

        let html = `
            <h5 class="mb-3">
                Consultas do mês
            </h5>
        `;

        if (consultasMes.length === 0) {

            html += `
                <div class="alert alert-secondary">
                    Nenhuma consulta encontrada.
                </div>
            `;
        }
        else {

            consultasMes.forEach(c => {

                html += `
                    <div class="card mb-3 shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between">

                                <div>

                                    <h6>
                                        Consulta #${c.consultaID}
                                    </h6>

                                    <p class="mb-1">
                                        <strong>Data:</strong>
                                        ${new Date(c.data).toLocaleString('pt-BR')}
                                    </p>

                                    <p class="mb-2">
                                        <strong>Descrição:</strong>
                                        ${c.descricao}
                                    </p>

                                </div>

                                ${modoDelete
                                    ? `
                                        <a
                                            href="/Consulta/Delete/${c.consultaID}"
                                            class="btn btn-danger btn-sm">

                                            🗑

                                        </a>
                                    `
                                    : ''
                                }

                            </div>

                        </div>

                    </div>
                `;
            });
        }

        document.getElementById(
            "consultasDoDia"
        ).innerHTML = html;
    }

    // =========================================
    // MOSTRAR CONSULTAS DO DIA
    // =========================================
    function mostrarConsultas(dia) {

        const mes = dataAtual.getMonth();
        const ano = dataAtual.getFullYear();

        let filtradas = consultas.filter(c => {

            let d = new Date(c.data);

            return d.getDate() === dia &&
                   d.getMonth() === mes &&
                   d.getFullYear() === ano;
        });

        let html = `
            <h5 class="mb-3">
                Consultas do dia ${dia}
            </h5>
        `;

        if (filtradas.length === 0) {

            html += `
                <div class="alert alert-secondary">
                    Nenhuma consulta encontrada.
                </div>
            `;
        }
        else {

            filtradas.forEach(c => {

                html += `
                    <div class="card mb-3 shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between">

                                <div>

                                    <h6>
                                        Consulta #${c.consultaID}
                                    </h6>

                                    <p class="mb-1">
                                        <strong>Data:</strong>
                                        ${new Date(c.data).toLocaleString('pt-BR')}
                                    </p>

                                    <p class="mb-2">
                                        <strong>Descrição:</strong>
                                        ${c.descricao}
                                    </p>

                                </div>

                                ${modoDelete
                                    ? `
                                        <a
                                            href="/Consulta/Delete/${c.consultaID}"
                                            class="btn btn-danger btn-sm">

                                            🗑

                                        </a>
                                    `
                                    : ''
                                }

                            </div>

                        </div>

                    </div>
                `;
            });
        }

        document.getElementById(
            "consultasDoDia"
        ).innerHTML = html;
    }

    // =========================================
    // VOLTAR PARA MÊS ATUAL
    // =========================================
    function irParaHoje() {

        dataAtual = new Date();

        renderizarCalendario();

        mostrarTodasConsultas();
    }

    // =========================================
    // INICIALIZAÇÃO
    // =========================================
    carregarAnos();

    renderizarCalendario();

    mostrarTodasConsultas();

</script>