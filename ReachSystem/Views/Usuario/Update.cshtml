@model ReachSystem.Models.ApplicationUser
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        background: #F4F7FB;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Sora', sans-serif;
    }

    .form-section {
        margin-bottom: 22px;
    }

        .form-section label {
            font-weight: 600;
            color: #173746;
            margin-bottom: 6px;
        }

    .form-control,
    .form-select {
        border-radius: 12px;
        height: 48px;
    }

    textarea.form-control {
        height: auto;
    }

    .card {
        border-radius: 22px !important;
        overflow: hidden;
    }
</style>

<div style="background:#F4F7FB; min-height:100vh; padding:30px 0;">

    <div class="container" style="max-width:1100px;">

      
        <div class="mb-4">
            <h2 class="fw-bold" style="color:#173746;">
                Atualizar Usuário
            </h2>

            <p style="color:#6C7A89;">
                Edite as informações do usuário.
            </p>
        </div>

      
        <div class="card shadow border-0">

 
            <div class="card-header text-white py-3"
                 style="background:#2C5D7C;">

                <h4 class="mb-0 fw-bold">
                    Dados do Usuário
                </h4>

            </div>

            <div class="card-body p-5">

                <form asp-action="Update">

                    <input asp-for="Id" type="hidden" />

                  
                    <div class="form-section">
                        <label asp-for="Nome"></label>

                        <input asp-for="Nome"
                               class="form-control" />

                        <span asp-validation-for="Nome"
                              class="text-danger"></span>
                    </div>

                   
                    <div class="form-section">
                        <label asp-for="Email"></label>

                        <input asp-for="Email"
                               class="form-control" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="form-section">
                        <label>Cargo</label>

                        <select class="form-select">
                            <option>Administrador</option>
                            <option>Funcionário</option>
                            <option>Voluntário</option>
                        </select>
                    </div>

                    <div class="mt-5 d-flex gap-3">

                        <button type="submit"
                                class="btn text-white px-5 py-2"
                                style="background:#2C5D7C;">
                            Atualizar
                        </button>

                        <a asp-action="Index"
                           class="btn btn-light border px-5 py-2">
                            Voltar
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>