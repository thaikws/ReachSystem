@model ReachSystem.Models.ApplicationUser

@{
    ViewData["Title"] = "Criar Usuário";
}

<style>
    body {
        background: #F4F7FB;
        font-family: 'Public Sans', sans-serif;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Sora', sans-serif;
    }

    .page-title {
        color: #173746;
        font-weight: 700;
    }

    .card-custom {
        background: #FFFFFF;
        border: none;
        border-radius: 18px;
        overflow: hidden;
    }

    .card-header-custom {
        background: #2C5D7C;
        color: #FFFFFF;
        padding: 18px 24px;
    }

        .card-header-custom h4 {
            margin: 0;
            font-weight: 600;
        }

    .form-section {
        margin-bottom: 22px;
    }

        .form-section label {
            font-weight: 600;
            color: #173746;
            margin-bottom: 6px;
        }

    .form-control,
    .form-select {
        border-radius: 12px;
        height: 48px;
    }

    .btn-primary-custom,
    .btn-back-custom {
        border-radius: 10px;
        padding: .6rem 1.5rem;
        font-weight: 600;
    }

    .btn-primary-custom {
        background: #2C5D7C;
        color: #FFFFFF;
        border: none;
    }

        .btn-primary-custom:hover {
            background: #234B64;
            color: #FFFFFF;
        }

    .btn-back-custom {
        background: #ECEFF3;
        color: #173746;
        border: none;
    }

        .btn-back-custom:hover {
            background: #DDE5EE;
            color: #173746;
        }

    /* ===========================
           RESPONSIVO
        =========================== */

    @@media (max-width: 768px) {

        .container {
            padding-left: 15px;
            padding-right: 15px;
        }

        .card-body {
            padding: 25px !important;
        }

        .card-header-custom {
            padding: 18px 22px;
        }

            .card-header-custom h4 {
                font-size: 1.15rem;
            }

        .form-section {
            margin-bottom: 18px;
        }

        .form-control,
        .form-select {
            height: 50px;
            font-size: .95rem;
        }

        .form-section label {
            font-size: .95rem;
        }

        .btn-primary-custom,
        .btn-back-custom {
            width: 100%;
            text-align: center;
        }

        .form-buttons {
            flex-direction: column-reverse;
        }
        /* Botão do olho */
        .position-relative .btn {
            width: 40px;
            height: 40px;
            padding: 0;
        }
    }
</style>

<div class="container py-4">

    <div class="mb-4">
        <h2 class="page-title">Criar Usuário</h2>
        <small style="color:#6C7A89;">
            Preencha as informações para cadastrar um novo usuário.
        </small>
    </div>

    <div class="card card-custom shadow-sm">

        <div class="card-header card-header-custom">
            <h4>Dados do Usuário</h4>
        </div>

        <div class="card-body p-4">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Create" method="post" autocomplete="off">

                <div class="form-section">
                    <label>Nome</label>

                    <input type="text"
                           name="nome"
                           class="form-control" />
                </div>

                <div class="form-section">
                    <label>Email</label>

                    <input type="email"
                           name="email"
                           class="form-control"
                           autocomplete="off" />
                </div>

                <div class="form-section">
                    <label>Senha</label>

                    <div class="position-relative">

                        <input type="password"
                               id="senha"
                               name="senha"
                               class="form-control"
                               autocomplete="new-password" />

                        <button type="button"
                                class="btn position-absolute end-0 top-50 translate-middle-y me-2"
                                onclick="mostrarSenha('senha')">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>
                </div>

                <div class="form-section">
                    <label>Cargo</label>

                    <select name="role" class="form-select">
                        <option value="Admin">Administrador</option>
                        <option value="Funcionario">Funcionário</option>
                        <option value="Voluntario">Voluntário</option>
                    </select>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2 form-buttons">

                    <a asp-action="Index"
                       class="btn btn-back-custom">
                        Voltar
                    </a>

                    <button type="submit"
                            class="btn btn-primary-custom px-4">
                        Criar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<script>

    function mostrarSenha(id) {

        var input = document.getElementById(id);

        var icon = event.currentTarget.querySelector("i");

        if (input.type === "password") {

            input.type = "text";
            icon.classList.remove("bi-eye");
            icon.classList.add("bi-eye-slash");

        } else {

            input.type = "password";
            icon.classList.remove("bi-eye-slash");
            icon.classList.add("bi-eye");

        }

    }

</script>