@model ReachSystem.Models.ApplicationUser

@{
    ViewData["Title"] = "Excluir Usuário";
}

<style>
body {
    background: #F4F7FB;
}

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Sora', sans-serif;
    }

/* ===========================
   Cabeçalho
=========================== */

.page-header {
    margin-bottom: 28px;
    margin-top: 25px;
}

.page-title {
    color: #173746;
    font-weight: 700;
    margin-bottom: 2px;
}

.page-subtitle {
    color: #6C7A89;
    margin-bottom: 0;
}

/* ===========================
   Card
=========================== */

.delete-card {
    border-radius: 22px;
    overflow: hidden;
}

.delete-card .card-body {
    padding: 50px;
}

.delete-content {
    text-align: center;
}

/* ===========================
   Ícone
=========================== */

.warning-icon {
    width: 90px;
    height: 90px;
    margin: 0 auto 22px;
    border-radius: 50%;
    background: #FDECEC;
    display: flex;
    justify-content: center;
    align-items: center;
}

.warning-icon i {
    font-size: 42px;
    color: #D9534F;
}

/* ===========================
   Texto
=========================== */

.delete-title {
    color: #173746;
    font-weight: 700;
    margin-bottom: 12px;
}

.delete-text {
    color: #6C7A89;
    margin-bottom: 10px;
    font-size: 1rem;
}

.delete-warning {
    color: #D9534F;
    font-weight: 600;
    margin-bottom: 35px;
}

/* ===========================
   Botões
=========================== */

.delete-actions {
    display: flex;
    justify-content: center;
    gap: 15px;
}

.btn-delete {
    background: #D9534F;
    color: white;
    padding: 12px 28px;
    border-radius: 12px;
    transition: .2s;
}

.btn-delete:hover {
    background: #c6423f;
    color: white;
}

.btn-cancel {
    background: white;
    border: 1px solid #DEE2E6;
    color: #173746;
    padding: 12px 28px;
    border-radius: 12px;
    transition: .2s;
}

.btn-cancel:hover {
    background: #F8F9FA;
    color: #173746;
}

/* ===========================
   RESPONSIVO
=========================== */

@@media (max-width:768px) {

    .container {
        padding-left: 15px;
        padding-right: 15px;
    }

    .page-header {
        margin-bottom: 22px;
    }

    .delete-card .card-body {
        padding: 30px 22px;
    }

    .warning-icon {
        width: 75px;
        height: 75px;
        margin-bottom: 18px;
    }

    .warning-icon i {
        font-size: 34px;
    }

    .delete-title {
        font-size: 1.35rem;
    }

    .delete-text,
    .delete-warning {
        font-size: .95rem;
    }

    .delete-actions {
        flex-direction: column;
    }

    .delete-actions .btn {
        width: 100%;
        padding: 13px;
    }

}
</style>

<div class="container" style="max-width:1100px;">

    <!-- Cabeçalho -->
    <div class="page-header">

        <h2 class="page-title">
            Excluir Usuário
        </h2>

        <p class="page-subtitle">
            Confirme a exclusão do usuário.
        </p>

    </div>

    <!-- Card -->
    <div class="card delete-card border-0 shadow-sm">

        <div class="card-body">

            <div class="delete-content">

                <div class="warning-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <h4 class="delete-title">
                    Tem certeza?
                </h4>

                <p class="delete-text">
                    Você está prestes a excluir o usuário
                    <strong>@Model.Nome</strong>.
                </p>

                <p class="delete-warning">
                    Esta ação não poderá ser desfeita.
                </p>

            </div>

            <form asp-action="Delete">

                <input type="hidden" name="id" value="@Model.Id" />

                <div class="delete-actions">

                    <button type="submit" class="btn btn-delete">
                        <i class="bi bi-trash"></i>
                        Excluir
                    </button>

                    <a asp-action="Index" class="btn btn-cancel">
                        <i class="bi bi-arrow-left"></i>
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>