@model ReachSystem.Models.ApplicationUser

<style>
    body {
    background: #F4F7FB;
    }

    h1, h2, h3, h4, h5, h6 {
    font-family: 'Sora', sans-serif;
    }
    </  style>

    

        <!-- Cabeçalho -->
        <div class="mb-4">
            <h2 class="fw-bold" style="color:#173746;">
                Excluir Usuário
            </h2>
            <p class="text-muted mb-0">
                Confirme a exclusão do usuário.
            </p>
        </div>

        <!-- Card -->
        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-5">

                <div class="text-center mb-4">
                    <i class="bi bi-exclamation-triangle-fill"
                       style="font-size:60px; color:#D9534F;"></i>

                    <h4 class="fw-bold mt-3" style="color:#173746;">
                        Tem certeza?
                    </h4>

                    <p class="text-muted">
                        Você está prestes a excluir o usuário
                        <strong>@Model.Nome</strong>.
                    </p>

                    <p class="text-danger fw-semibold">
                        Esta ação não poderá ser desfeita.
                    </p>
                </div>

                <form asp-action="Delete">

                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="d-flex justify-content-center gap-3 mt-4">

                        <button type="submit"
                                class="btn text-white px-4 py-2 rounded-3"
                                style="background-color:#D9534F;">
                            <i class="bi bi-trash"></i>
                            Excluir
                        </button>

                        <a asp-action="Index"
                           class="btn btn-light border px-4 py-2 rounded-3">
                            <i class="bi bi-arrow-left"></i>
                            Cancelar
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>