@model IEnumerable<ReachSystem.Models.ViewModels.UsuarioViewModel>

@{
    ViewData["Title"] = "Usuários";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

    body {
        background: #F4F7FB;
        font-family: 'Public Sans', sans-serif;
    }

    h1, h2, h3, h4 {
        font-family: 'Sora', sans-serif;
    }

    .page-title {
        color: #173746;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .page-subtitle {
        color: #6C7A89;
        margin-bottom: 0;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        gap: 20px;
    }

    .btn-create {
        background: #2C5D7C;
        color: white;
        border-radius: 12px;
        border: none;
        padding: 12px 22px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-create:hover {
            background: #234B64;
            color: white;
        }

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 20px;
    }

    .search-box {
        position: relative;
        width: 350px;
    }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #8b97a3;
        }

        .search-box input {
            width: 100%;
            border: 1px solid #E6EDF5;
            background: white;
            border-radius: 14px;
            padding: 12px 18px 12px 42px;
            outline: none;
            transition: .2s;
        }

            .search-box input:focus {
                border-color: #2C5D7C;
            }

    .selected-info {
        display: none;
        font-weight: 600;
        color: #173746;
    }

    .table-container {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
    }

    table {
        margin: 0 !important;
    }

    thead {
        background: #E6EDF5;
    }

        thead th {
            color: #173746;
            font-weight: 600;
            border: none !important;
            padding: 15px;
        }

    tbody td {
        vertical-align: middle;
        padding: 15px;
        border-color: #EDF2F7;
    }

    tbody tr:hover {
        background: #F8FBFE;
    }

    .role-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: .85rem;
        font-weight: 600;
    }

    .role-admin {
        background: #DDEEFF;
        color: #1B6EC2;
    }

    .role-funcionario {
        background: #ECEFF3;
        color: #173746;
    }

    .role-voluntario {
        background: #E8F8EC;
        color: #2E7D32;
    }

    .action-btn {
        width: 35px;
        height: 35px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 10px;
        text-decoration: none;
        transition: .2s;
        margin-right: 5px;
    }

    .edit-btn {
        color: #1B6EC2;
    }

        .edit-btn:hover {
            background: #EAF3FC;
        }

    .delete-btn {
        color: #D9534F;
    }

        .delete-btn:hover {
            background: #FCEAEA;
        }

    input[type=checkbox] {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .table tbody tr.selected {
        background: #EAF3FC !important;
    }

        .table tbody tr.selected:hover {
            background: #EAF3FC !important;
        }

</style>

<div class="container py-4">

    <div class="top-bar">

        <div>

            <h2 class="page-title">
                Usuários
            </h2>

            <p class="page-subtitle">
                Gerencie os usuários cadastrados no sistema.
            </p>

        </div>

        <a asp-action="Create" class="btn btn-create">
            <i class="bi bi-plus-lg"></i>
            Novo Usuário
        </a>

    </div>

    <div class="toolbar">

        <div class="search-box">

            <i class="bi bi-search"></i>

            <input type="text"
                   id="searchInput"
                   placeholder="Pesquisar por nome ou e-mail..." />

        </div>

        <div class="selected-info" id="selectedInfo">
            0 usuários selecionados
        </div>

    </div>

    <div class="table-container">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th width="50">
                        <input type="checkbox" id="checkAll">
                    </th>

                    <th>Nome</th>

                    <th>Email</th>

                    <th width="180">
                        Cargo
                    </th>

                    <th width="120" class="text-center">
                        Ações
                    </th>

                </tr>

            </thead>

            <tbody id="tableBody">

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <input type="checkbox" class="user-check">
                        </td>

                        <td>@item.Nome</td>

                        <td>@item.Email</td>

                        <td>

                            @if (item.Role == "Admin")
                            {
                                <span class="role-badge role-admin">
                                    Administrador
                                </span>
                            }
                            else if (item.Role == "Funcionario")
                            {
                                <span class="role-badge role-funcionario">
                                    Funcionário
                                </span>
                            }
                            else
                            {
                                <span class="role-badge role-voluntario">
                                    Voluntário
                                </span>
                            }

                        </td>

                        <td class="text-center">

                            <a asp-action="Update"
                               asp-route-id="@item.Id"
                               class="action-btn edit-btn">

                                <i class="bi bi-pencil-fill"></i>

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="action-btn delete-btn">

                                <i class="bi bi-trash-fill"></i>

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
@if (TempData["Sucesso"] != null)
{
    <script>
        alert('@TempData["Sucesso"]');
    </script>
}
<script>

    // ===========================
    // Pesquisa
    // ===========================

    const searchInput = document.getElementById("searchInput");
    const tableBody = document.getElementById("tableBody");

    searchInput.addEventListener("keyup", function () {

        const texto = this.value.toLowerCase();

        const linhas = tableBody.querySelectorAll("tr");

        linhas.forEach(linha => {

            const nome = linha.cells[1].textContent.toLowerCase();
            const email = linha.cells[2].textContent.toLowerCase();

            if (nome.includes(texto) || email.includes(texto)) {
                linha.style.display = "";
            }
            else {
                linha.style.display = "none";
            }

        });

    });

    // ===========================
    // Seleção
    // ===========================

    const checkAll = document.getElementById("checkAll");
    const checkboxes = document.querySelectorAll(".user-check");
    const selectedInfo = document.getElementById("selectedInfo");

    checkAll.addEventListener("change", function () {

        checkboxes.forEach(c => {

            c.checked = this.checked;

            c.closest("tr").classList.toggle("selected", this.checked);

        });

        atualizarSelecionados();

    });

    checkboxes.forEach(c => {

        c.addEventListener("change", function () {

            this.closest("tr").classList.toggle("selected", this.checked);

            atualizarSelecionados();

        });

    });

    function atualizarSelecionados() {

        let total = 0;

        checkboxes.forEach(c => {

            if (c.checked)
                total++;

        });

        if (total === 0) {

            selectedInfo.style.display = "none";
            checkAll.checked = false;

        }
        else {

            selectedInfo.style.display = "block";
            selectedInfo.innerHTML = `
                <i class="bi bi-check2-square"></i>
                ${total} usuário${total > 1 ? "s" : ""} selecionado${total > 1 ? "s" : ""}
            `;

            // Marca o checkbox principal se todos estiverem selecionados
            checkAll.checked = total === checkboxes.length;

        }

    }

</script>